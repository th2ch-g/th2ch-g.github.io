---
import type { MarkdownHeading } from 'astro';
import { t, type Lang } from '@/i18n/ui';

interface Props {
  headings: MarkdownHeading[];
  lang: Lang;
}
const { headings, lang } = Astro.props;
// Astro's `headings` only contains body-content headings — the
// frontmatter-derived `<h1>{post.data.title}</h1>` (PostDetailPage.astro)
// is NOT in this list, so there's no risk of double-listing the title.
//
// Some authors top out their body at h1 ("# Section"), others at h2
// ("## Section"). Pick the shallowest depth that actually appears as
// the TOC's top level and include up to two further levels under it,
// yielding a three-level nested bullet outline (disc → circle → square).
const minDepth = headings.length > 0 ? Math.min(...headings.map((h) => h.depth)) : 2;
const flat = headings.filter((h) => h.depth >= minDepth && h.depth <= minDepth + 2);

type TocNode = MarkdownHeading & { children: TocNode[] };
// Monotonic-stack tree build: pop ancestors whose depth is >= current,
// then attach the new node to whatever remains on top (or to `root`).
function buildTree(items: MarkdownHeading[]): TocNode[] {
  const root: TocNode[] = [];
  const stack: TocNode[] = [];
  for (const item of items) {
    const node: TocNode = { ...item, children: [] };
    while (stack.length > 0 && stack[stack.length - 1].depth >= item.depth) {
      stack.pop();
    }
    if (stack.length === 0) root.push(node);
    else stack[stack.length - 1].children.push(node);
    stack.push(node);
  }
  return root;
}

// Headings come from Astro's Markdown pipeline (build-time only), but
// `text` can contain inline HTML, so escape before injecting via set:html.
function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

// `rehype-autolink-headings` runs with `behavior: 'prepend'` and
// `content: '#'` (see astro.config.mjs), which leaks a leading "#" into
// the heading text Astro extracts for the TOC. Strip a single leading
// "#" plus optional whitespace so the TOC shows clean labels.
function cleanHeadingText(raw: string): string {
  return raw.replace(/^\s*#+\s*/, '');
}

function renderTree(nodes: TocNode[]): string {
  if (nodes.length === 0) return '';
  const children = nodes
    .map((n) => {
      const slug = escapeHtml(n.slug);
      const text = escapeHtml(cleanHeadingText(n.text));
      return `<li class="toc-item"><a href="#${slug}" data-toc-link="${slug}">${text}</a>${renderTree(n.children)}</li>`;
    })
    .join('');
  return `<ul class="toc-list">${children}</ul>`;
}

const tree = buildTree(flat);
---
{flat.length >= 2 && (
  <>
    <button
      class="toc-toggle"
      type="button"
      data-toc-toggle
      aria-controls="post-toc-panel"
      aria-expanded="false"
      aria-label={t(lang, 'posts.toc.open')}
    >
      {t(lang, 'posts.toc')}
    </button>
    <button
      class="toc-backdrop"
      type="button"
      data-toc-backdrop
      aria-label={t(lang, 'posts.toc.close')}
      tabindex="-1"
    ></button>
    <aside
      id="post-toc-panel"
      class="toc"
      data-toc-panel
      aria-label={t(lang, 'posts.toc')}
    >
      <div class="toc-head">
        <p class="toc-title">{t(lang, 'posts.toc')}</p>
        <button
          class="toc-close"
          type="button"
          data-toc-close
          aria-label={t(lang, 'posts.toc.close')}
        >
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <Fragment set:html={renderTree(tree)} />
    </aside>
  </>
)}

<script>
  import { onReady } from '@/lib/dom-ready';

  let activeObserver: IntersectionObserver | null = null;
  const desktopMedia = window.matchMedia('(min-width: 84rem)');

  function wireToc() {
    activeObserver?.disconnect();
    activeObserver = null;

    const panel = document.querySelector<HTMLElement>('[data-toc-panel]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]');
    const closeButton = document.querySelector<HTMLButtonElement>('[data-toc-close]');
    const backdrop = document.querySelector<HTMLButtonElement>('[data-toc-backdrop]');
    if (!panel || !toggle || !closeButton || !backdrop) return;
    const tocPanel = panel;
    const tocToggle = toggle;
    const tocCloseButton = closeButton;
    const tocBackdrop = backdrop;

    let isOpen = false;

    function syncA11y() {
      const isDesktop = desktopMedia.matches;
      tocToggle.setAttribute('aria-expanded', String(!isDesktop && isOpen));
      if (isDesktop) {
        tocPanel.removeAttribute('aria-hidden');
        tocPanel.inert = false;
        document.body.classList.remove('toc-drawer-open');
        return;
      }
      tocPanel.setAttribute('aria-hidden', String(!isOpen));
      tocPanel.inert = !isOpen;
      document.body.classList.toggle('toc-drawer-open', isOpen);
    }

    function openDrawer() {
      if (desktopMedia.matches) return;
      isOpen = true;
      tocPanel.classList.add('is-open');
      tocBackdrop.classList.add('is-open');
      syncA11y();
      tocCloseButton.focus();
    }

    function closeDrawer(restoreFocus = true) {
      const wasOpen = isOpen;
      isOpen = false;
      tocPanel.classList.remove('is-open');
      tocBackdrop.classList.remove('is-open');
      syncA11y();
      if (wasOpen && restoreFocus) tocToggle.focus();
    }

    tocToggle.addEventListener('click', openDrawer);
    tocCloseButton.addEventListener('click', () => closeDrawer());
    tocBackdrop.addEventListener('click', () => closeDrawer());
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen) closeDrawer();
    });
    tocPanel.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((link) => {
      link.addEventListener('click', () => {
        if (!desktopMedia.matches) closeDrawer(false);
      });
    });
    desktopMedia.addEventListener('change', () => closeDrawer(false));
    syncA11y();

    const linkMap = new Map<string, HTMLElement>();
    tocPanel.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((el) => {
      const slug = el.dataset.tocLink;
      if (slug) linkMap.set(slug, el);
    });

    if (linkMap.size > 0 && 'IntersectionObserver' in window) {
      // Bias the active zone toward the upper third so the link switches
      // before its heading reaches the top edge.
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const link = linkMap.get(entry.target.id);
            if (!link) return;
            if (entry.isIntersecting) {
              link.classList.add('is-active');
              // `aria-current="location"` is the schema.org-aligned way to
              // mark the in-viewport section so screen readers can
              // announce position changes — complements the visual
              // `.is-active` class.
              link.setAttribute('aria-current', 'location');
            } else {
              link.classList.remove('is-active');
              link.removeAttribute('aria-current');
            }
          });
        },
        { rootMargin: '-20% 0% -70% 0%' },
      );
      linkMap.forEach((_, slug) => {
        const heading = document.getElementById(slug);
        if (heading) observer.observe(heading);
      });
      activeObserver = observer;
    }
  }
  onReady(wireToc);
</script>

<style>
  .toc-toggle {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 70;
    transform: translateY(-50%);
    writing-mode: vertical-rl;
    padding: 0.7rem 0.4rem;
    border: 1px solid var(--color-border);
    border-right: 0;
    border-radius: var(--radius) 0 0 var(--radius);
    background: var(--color-card);
    color: var(--color-fg);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
  }
  .toc-backdrop {
    position: fixed;
    inset: 0;
    z-index: 75;
    border: 0;
    background: rgba(0, 0, 0, 0.46);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }
  .toc-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .toc {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 80;
    width: min(20rem, 88vw);
    height: 100dvh;
    overflow-y: auto;
    border: 1px solid color-mix(in srgb, var(--color-border) 78%, var(--color-accent));
    background:
      linear-gradient(
        145deg,
        color-mix(in srgb, var(--color-accent) 10%, var(--color-card)) 0,
        var(--color-card) 5rem
      );
    padding: 1rem;
    font-size: 0.9rem;
    transform: translateX(100%);
    transition: transform 180ms ease;
    box-shadow: -12px 0 32px rgba(0, 0, 0, 0.22);
  }
  .toc.is-open {
    transform: translateX(0);
  }
  .toc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .toc-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--color-fg);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .toc-title::before {
    content: '';
    width: 0.28rem;
    height: 1.05rem;
    border-radius: 999px;
    background: linear-gradient(180deg, var(--color-accent), var(--color-accent-hover));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 12%, transparent);
  }
  .toc-close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: transparent;
    color: var(--color-fg);
    font-size: 1.4rem;
    cursor: pointer;
  }
  /* The list is injected via set:html, so its descendants do not carry
     this component's scoped-style attribute — wrap selectors in :global()
     so the nested navigation rules still apply. */
  :global(.toc .toc-list) {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  :global(.toc .toc-list .toc-list) {
    margin: 0.15rem 0 0.25rem 0.6rem;
    padding-left: 0.65rem;
    border-left: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    font-size: 0.93em;
  }
  :global(.toc .toc-list .toc-list .toc-list) {
    margin-left: 0.35rem;
  }
  :global(.toc .toc-item) {
    margin: 0.08rem 0;
    line-height: 1.45;
  }
  :global(.toc .toc-item a) {
    display: block;
    margin-left: -0.45rem;
    padding: 0.3rem 0.45rem;
    border-radius: 0.4rem;
    color: var(--color-muted);
    text-wrap: pretty;
    transition: color 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
  }
  :global(.toc > .toc-list > .toc-item > a) {
    color: var(--color-fg);
    font-weight: 600;
  }
  :global(.toc .toc-item a:hover) {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    text-decoration: none;
  }
  :global(.toc .toc-item a.is-active) {
    color: var(--color-accent);
    font-weight: 600;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    box-shadow: inset 3px 0 var(--color-accent);
  }
  :global(body.toc-drawer-open) {
    overflow: hidden;
  }
  @media (min-width: 84rem) {
    .toc-toggle,
    .toc-backdrop,
    .toc-close {
      display: none;
    }
    .toc {
      position: sticky;
      top: 4.75rem;
      z-index: auto;
      width: auto;
      height: auto;
      max-height: calc(100vh - 5.75rem);
      margin: 0;
      border-radius: var(--radius);
      padding: 0.85rem 1rem 1rem;
      transform: none;
      transition: none;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
    }
    .toc-head {
      margin-bottom: 0.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .toc,
    .toc-backdrop,
    :global(.toc .toc-item a) {
      transition: none;
    }
  }
</style>
