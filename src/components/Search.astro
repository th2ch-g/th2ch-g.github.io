---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { tUi, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }

const { lang } = Astro.props;
const assetBase = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---
<button
  type="button"
  class="search-trigger btn btn-ghost btn-sm"
  data-search-open
  aria-label={tUi('search.title')}
  title={tUi('search.title')}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7" />
    <path d="m20 20-3.5-3.5" />
  </svg>
  <kbd class="kbd">⌘K</kbd>
</button>

<dialog
  class="search-dialog"
  data-search-dialog
  data-search-dev={import.meta.env.DEV ? '' : undefined}
  data-pagefind-base={`${assetBase}pagefind/`}
  data-search-index-url={`${assetBase}search-index.json`}
  data-posts-base={getRelativeLocaleUrl(lang, '/posts')}
  data-no-results={tUi('search.noResults')}
  data-results-label={tUi('search.results')}
  aria-label={tUi('search.title')}
>
  <div class="search-shell">
    <div class="search-dialog-bar">
      <strong>{tUi('search.title')}</strong>
      <button
        type="button"
        class="search-close btn btn-ghost btn-sm"
        data-search-close
        aria-label={tUi('search.close')}
      >
        {tUi('shortcuts.close')}
      </button>
    </div>
    <div id="pagefind-search" data-placeholder={tUi('search.placeholder')}></div>
    <p class="search-error muted" data-search-error hidden>
      {tUi('search.unavailable')}
    </p>
  </div>
</dialog>

<script>
  import { onReady } from '@/lib/dom-ready';
  import { setupSearch } from '@/lib/search';

  onReady(setupSearch);
</script>

<style>
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--color-card) 76%, transparent);
    color: var(--color-muted);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .search-trigger:hover,
  .search-trigger:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.05rem 0.3rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  .search-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    border: none;
    padding: 0;
    background: transparent;
    width: min(640px, calc(100vw - 2rem));
    max-width: none;
    max-height: calc(100dvh - 2rem);
    overflow: auto;
  }
  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(2px);
  }
  .search-shell {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius) + 0.2rem);
    padding: 1.1rem;
    box-shadow: var(--shadow-float);
  }
  .search-dialog-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .search-dialog-bar strong {
    font-size: 1rem;
  }
  .search-close {
    min-height: 2rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-field);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
  }
  .search-close:hover,
  .search-close:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .search-error {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  @media (max-width: 540px) {
    .search-trigger .kbd { display: none; }
  }
</style>

<style is:global>
  #pagefind-search {
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-fg);
    --pagefind-ui-background: var(--color-card);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-bg);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-font: var(--font-sans);
  }
  #pagefind-search mark {
    background: var(--color-accent);
    color: var(--color-bg);
    padding: 0 0.15em;
    border-radius: 2px;
  }
  #pagefind-search .pagefind-ui__result-title,
  #pagefind-search .pagefind-ui__result-link {
    color: var(--color-fg);
  }
  #pagefind-search .pagefind-ui__result-excerpt {
    color: var(--color-muted);
  }
  #pagefind-search .pagefind-ui__result-link:hover {
    color: var(--color-accent);
  }
  #pagefind-search .search-fallback {
    display: grid;
    gap: 0.8rem;
  }
  #pagefind-search .search-fallback__input {
    width: 100%;
    min-height: 2.8rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-field);
    background: var(--color-card);
    color: var(--color-fg);
    font: inherit;
  }
  #pagefind-search .search-fallback__input:focus-visible {
    border-color: var(--color-accent);
    outline: 2px solid color-mix(in oklab, var(--color-accent) 30%, transparent);
    outline-offset: 1px;
  }
  #pagefind-search .search-fallback__status {
    min-height: 1.25rem;
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  #pagefind-search .search-fallback__results {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #pagefind-search .search-fallback__result {
    padding: 0.8rem 0;
    border-top: 1px solid var(--color-border);
  }
  #pagefind-search .search-fallback__result:first-child {
    border-top: 0;
  }
  #pagefind-search .search-fallback__link {
    color: var(--color-fg);
    font-weight: 650;
  }
  #pagefind-search .search-fallback__link:hover {
    color: var(--color-accent);
  }
  #pagefind-search .search-fallback__description,
  #pagefind-search .search-fallback__meta {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.85rem;
  }
  #pagefind-search .search-fallback__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
</style>
