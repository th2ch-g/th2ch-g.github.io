---
import type { CollectionEntry } from 'astro:content';
import { t, type Lang } from '@/i18n/ui';
import { localeSlug, formatDate } from '@/lib/content';
import { getPostVisualHue } from '@/lib/post-visual';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: Lang;
}
const { post, lang } = Astro.props;
const slug = localeSlug(post.id);
const href = getRelativeLocaleUrl(lang, `/posts/${slug}`);
const visualStyle = `--post-visual-hue: ${getPostVisualHue(slug)}`;
---
<article
  class="card post-card"
  data-tags={JSON.stringify(post.data.tags ?? [])}
  data-pubdate={post.data.pubDate.toISOString()}
  style={visualStyle}
>
  <a href={href} class="post-link" aria-label={post.data.title}>
    <div class="visual">
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="categories">
          {post.data.tags.map((tag) => <span class="category">{tag}</span>)}
        </div>
      )}
      <span class="emoji" aria-hidden="true">{post.data.emoji}</span>
    </div>
    <div class="body">
      <h3 class="title">
        {post.data.title}
        {post.data.draft && <span class="draft-badge">{t(lang, 'posts.draft')}</span>}
      </h3>
      <div class="card-meta">
        <time class="muted" datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate, lang)}
        </time>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card {
    height: 100%;
    margin-bottom: 0;
    padding: 0;
    overflow: hidden;
  }
  .post-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .post-link:hover { color: inherit; text-decoration: none; }
  .visual {
    position: relative;
    min-height: 9.5rem;
    display: grid;
    place-items: center;
    padding-top: 2.4rem;
    background:
      radial-gradient(circle at 75% 20%, rgba(255, 255, 255, 0.18), transparent 42%),
      hsl(var(--post-visual-hue) 25% 36%);
  }
  :global(:root[data-theme="light"]) .visual {
    background:
      radial-gradient(circle at 75% 20%, rgba(255, 255, 255, 0.6), transparent 42%),
      hsl(var(--post-visual-hue) 38% 80%);
  }
  .categories {
    position: absolute;
    top: 0.7rem;
    right: 0.75rem;
    left: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .category {
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background: #0969da;
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    line-height: 1.5;
  }
  .emoji {
    font-size: 3.1rem;
    line-height: 1;
    filter: drop-shadow(0 5px 10px rgba(0, 0, 0, 0.18));
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0.95rem 1rem 1rem;
  }
  .title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    margin: 0 0 0.8rem;
    font-size: 1.05rem;
    line-height: 1.45;
  }
  .card-meta {
    display: flex;
    align-items: center;
    margin-top: auto;
    min-width: 0;
    font-size: 0.78rem;
  }
  .card-meta time {
    margin-left: auto;
    flex: 0 0 auto;
    font-size: 0.72rem;
  }
  .draft-badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.5rem;
    border: 1px solid var(--color-warn);
    border-radius: 999px;
    color: var(--color-warn);
    font-size: 0.7rem;
    font-weight: 600;
    vertical-align: middle;
    line-height: 1.4;
  }
</style>
