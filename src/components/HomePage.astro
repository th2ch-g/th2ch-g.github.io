---
import Base from '@/layouts/Base.astro';
import CVSection from './CVSection.astro';
import LocaleContent from './LocaleContent.astro';
import type { Lang } from '@/i18n/ui';
import { getProfileMeta } from '@/lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;

const meta = await getProfileMeta(lang);
const japaneseMeta = await getProfileMeta('ja');
---
<Base lang={lang} title={meta.name} japanese={{ title: japaneseMeta.name }}>
  <LocaleContent>
    <Fragment slot="en">
      <CVSection lang={lang} />
    </Fragment>
    <Fragment slot="ja">
      <CVSection lang="ja" />
    </Fragment>
  </LocaleContent>
</Base>
