---
import Base from '@/layouts/Base.astro';
import LocaleContent from './LocaleContent.astro';
import ContactContent from './ContactContent.astro';
import { tUi, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Keep a document title and an accessible heading without a visible label.
const title = tUi('nav.contact');
const description = tUi('contact.description');

---
<Base lang={lang} title={title} description={description}>
  <h1 class="sr-only">{title}</h1>
  <LocaleContent>
    <ContactContent slot="en" lang={lang} />
    <ContactContent slot="ja" lang="ja" />
  </LocaleContent>
</Base>
