---
import Base from '@/layouts/Base.astro';
import { tUi } from '@/i18n/ui';

// GitHub Pages serves one error document for every missing path.
---
<Base lang="en" title="404 — Not Found" availableLocales={['en']}>
  <h1 class="big-404">404</h1>
  <section>
    <h2>{tUi('404.title')}</h2>
    <p>{tUi('404.message')}</p>
    <p><a href="/?lang=en" hreflang="en">{tUi('404.home.en')} →</a></p>
    <p><a href="/?lang=ja" hreflang="ja">{tUi('404.home.ja')} →</a></p>
  </section>
</Base>

<style>
  .big-404 {
    font-size: clamp(4rem, 18vw, 8rem);
    font-weight: 800;
    margin: 0.5rem 0 0.25rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    line-height: 1;
  }
</style>
