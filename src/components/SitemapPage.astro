---
import Base from '@/layouts/Base.astro';
import LocaleContent from './LocaleContent.astro';
import SitemapContent from './SitemapContent.astro';
import { tUi, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} title={tUi('sitemap.title')} description={tUi('sitemap.description')}>
  <LocaleContent>
    <SitemapContent slot="en" lang="en" />
    <SitemapContent slot="ja" lang="ja" />
  </LocaleContent>
</Base>
