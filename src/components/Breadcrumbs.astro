---
import { tUi, type Lang } from '@/i18n/ui';

// Renders a Schema.org `BreadcrumbList` using Microdata so search engines
// can show breadcrumb-style URLs in result snippets without needing a
// separate JSON-LD block. The last item is rendered as plain text — by
// convention, the current page is not a clickable link.
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
  lang: Lang;
}
const { items } = Astro.props;
---
<nav class="breadcrumb-nav" aria-label={tUi('breadcrumb.label')}>
  <ol itemscope itemtype="https://schema.org/BreadcrumbList">
    {items.map((it, i) => (
      <li
        itemprop="itemListElement"
        itemscope
        itemtype="https://schema.org/ListItem"
        class:list={[{ 'is-current': !it.href || i === items.length - 1 }]}
      >
        {i > 0 && <span class="breadcrumb-separator" aria-hidden="true">/</span>}
        {it.href && i < items.length - 1 ? (
          <a href={it.href} itemprop="item">
            <span itemprop="name">{it.label}</span>
          </a>
        ) : (
          <span itemprop="name" aria-current="page">{it.label}</span>
        )}
        <meta itemprop="position" content={String(i + 1)} />
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb-nav {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .breadcrumb-nav ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .breadcrumb-nav li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .breadcrumb-separator {
    color: var(--color-muted);
  }
  .breadcrumb-nav a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .breadcrumb-nav a:hover { text-decoration: underline; }
  .breadcrumb-nav [aria-current="page"] { color: var(--color-fg); font-weight: 500; }
</style>
