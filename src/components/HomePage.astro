---
import Base from '@/layouts/Base.astro';
import CVSection from './CVSection.astro';
import type { Lang } from '@/i18n/ui';
import { getProfileMeta } from '@/lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;

const meta = await getProfileMeta(lang);
---
{/* Home page is titled with the site brand (meta.name), not "Home": this
    collapses `documentTitle` to just the brand and makes og:title /
    twitter:title the brand instead of a generic "Home" on social shares.
    No description is passed: Base falls back to the bio. */}
<Base lang={lang} title={meta.name}>
  <section class="hero">
    <div class="hero-head">
      <h1>{meta.name}</h1>
      {meta.bio && <p class="bio">{meta.bio}</p>}
    </div>
  </section>

  <CVSection lang={lang} />
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    margin-bottom: 1rem;
    padding: 0.5rem 0 1rem;
  }
  .hero-head {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  .hero-head > h1 {
    margin: 0;
    font-size: 1.625rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .bio {
    font-size: 1rem;
    color: var(--color-muted);
    margin: 0;
  }
</style>
