---
import { tUi, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const label = tUi('theme.toggle');
---
<button type="button" class="theme-toggle btn btn-ghost btn-sm" data-theme-toggle aria-label={label} title={label}>
  <svg class="icon sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
  </svg>
  <svg class="icon moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z" />
  </svg>
</button>

<script>
  import { onReady } from '@/lib/dom-ready';

  // Pre-paint script in Base.astro already set html[data-theme]. This script
  // wires the toggle button(s) and persists the choice in localStorage.
  const STORAGE_KEY = 'theme';

  function apply(theme: 'light' | 'dark') {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem(STORAGE_KEY, theme);
    } catch {
      // localStorage may be blocked (private mode, strict cookie settings); ignore.
    }
  }

  // Wire on DOMContentLoaded — `<ClientRouter />` was removed, so the
  // `astro:page-load` event is never dispatched. Astro module scripts
  // are defer-loaded so `readyState` is usually already past 'loading',
  // but we register both paths for safety.
  function wireThemeToggles() {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
        apply(current === 'dark' ? 'light' : 'dark');
      });
    });
  }
  onReady(wireThemeToggles);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    min-height: 2rem;
    flex-shrink: 0;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-field);
    color: var(--color-fg);
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
  }
  .theme-toggle:hover {
    border-color: var(--color-border-strong);
    background: var(--color-hover);
  }
  .theme-toggle:active { background: var(--color-button-active); }
  .icon {
    display: none;
  }
  /* Show the icon representing the *target* theme (what clicking will switch to). */
  :global(:root[data-theme="light"]) .theme-toggle .moon,
  :global(:root:not([data-theme])) .theme-toggle .moon {
    display: inline;
  }
  :global(:root[data-theme="dark"]) .theme-toggle .sun {
    display: inline;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .theme-toggle .moon {
      display: none;
    }
    :global(:root:not([data-theme])) .theme-toggle .sun {
      display: inline;
    }
  }
</style>
