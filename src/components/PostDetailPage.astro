---
import Base from '@/layouts/Base.astro';
import LocaleContent from './LocaleContent.astro';
import PostContent from './PostContent.astro';
import { tUi } from '@/i18n/ui';
import { getWordCount, localeSlug } from '@/lib/content';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl, getLocaleFileUrl } from '@/lib/locale-url';

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const locales = post.data.lang;
const lang = locales.includes('en') ? 'en' : 'ja';
const slug = localeSlug(post.id);
---
<Base
  lang={lang}
  availableLocales={locales}
  localeFallbackPath="/posts/"
  title={post.data.title}
  description={post.data.description}
  image={getLocaleFileUrl(lang, `/og/${slug}.png`)}
  article={{
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    updatedDate: post.data.updatedDate,
    wordCount: getWordCount(post.body ?? '', lang),
  }}
  breadcrumbs={[
    { name: tUi('nav.home'), url: getRelativeLocaleUrl(lang, '/') },
    { name: tUi('nav.posts'), url: getRelativeLocaleUrl(lang, '/posts') },
    { name: post.data.title },
  ]}
>
  <LocaleContent defaultLang={lang}>
    {locales.includes('en') && <PostContent slot="en" post={post} lang="en" />}
    {locales.includes('ja') && <PostContent slot="ja" post={post} lang="ja" />}
  </LocaleContent>
</Base>
