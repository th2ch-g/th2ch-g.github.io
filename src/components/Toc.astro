---
import type { MarkdownHeading } from 'astro';
import { tUi, type Lang } from '@/i18n/ui';

interface Props {
  headings: MarkdownHeading[];
  lang: Lang;
}
const { headings } = Astro.props;
// Astro's `headings` only contains body-content headings — the
// frontmatter-derived `<h1>{post.data.title}</h1>` (PostDetailPage.astro)
// is NOT in this list, so there's no risk of double-listing the title.
//
// Some authors top out their body at h1 ("# Section"), others at h2
// ("## Section"). Pick the shallowest depth that actually appears as
// the TOC's top level and include up to two further levels under it,
// yielding a three-level hierarchical rail outline.
const minDepth = headings.length > 0 ? Math.min(...headings.map((h) => h.depth)) : 2;
const flat = headings.filter((h) => h.depth >= minDepth && h.depth <= minDepth + 2);

type TocNode = MarkdownHeading & { children: TocNode[] };
// Monotonic-stack tree build: pop ancestors whose depth is >= current,
// then attach the new node to whatever remains on top (or to `root`).
function buildTree(items: MarkdownHeading[]): TocNode[] {
  const root: TocNode[] = [];
  const stack: TocNode[] = [];
  for (const item of items) {
    const node: TocNode = { ...item, children: [] };
    while (stack.length > 0 && stack[stack.length - 1].depth >= item.depth) {
      stack.pop();
    }
    if (stack.length === 0) root.push(node);
    else stack[stack.length - 1].children.push(node);
    stack.push(node);
  }
  return root;
}

// Headings come from Astro's Markdown pipeline (build-time only), but
// `text` can contain inline HTML, so escape before injecting via set:html.
function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

// `rehype-autolink-headings` runs with `behavior: 'prepend'` and
// `content: '#'` (see astro.config.mjs), which leaks a leading "#" into
// the heading text Astro extracts for the TOC. Strip a single leading
// "#" plus optional whitespace so the TOC shows clean labels.
function cleanHeadingText(raw: string): string {
  return raw.replace(/^\s*#+\s*/, '');
}

function renderTree(nodes: TocNode[]): string {
  if (nodes.length === 0) return '';
  const children = nodes
    .map((n) => {
      const slug = escapeHtml(n.slug);
      const text = escapeHtml(cleanHeadingText(n.text));
      return `<li class="toc-item"><a href="#${slug}" data-toc-link="${slug}">${text}</a>${renderTree(n.children)}</li>`;
    })
    .join('');
  return `<ul class="toc-list">${children}</ul>`;
}

const tree = buildTree(flat);
---
{flat.length >= 2 && (
  <>
    <button
      class="toc-toggle"
      type="button"
      data-toc-toggle
      aria-controls="post-toc-panel"
      aria-expanded="false"
      aria-label={tUi('posts.toc.open')}
    >
      <span class="toc-toggle-full">{tUi('posts.toc')}</span>
      <span class="toc-toggle-short" aria-hidden="true">TOC</span>
    </button>
    <button
      class="toc-backdrop"
      type="button"
      data-toc-backdrop
      aria-label={tUi('posts.toc.close')}
      tabindex="-1"
    ></button>
    <aside
      id="post-toc-panel"
      class="toc"
      data-toc-panel
      aria-label={tUi('posts.toc')}
    >
      <div class="toc-head">
        <p class="toc-title">{tUi('posts.toc')}</p>
        <button
          class="toc-close btn btn-ghost btn-circle btn-sm"
          type="button"
          data-toc-close
          aria-label={tUi('posts.toc.close')}
        >
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <Fragment set:html={renderTree(tree)} />
    </aside>
  </>
)}

<script>
  import { onReady } from '@/lib/dom-ready';

  let activeObserver: IntersectionObserver | null = null;
  const desktopMedia = window.matchMedia('(min-width: 90rem)');

  function wireToc() {
    activeObserver?.disconnect();
    activeObserver = null;

    const panel = document.querySelector<HTMLElement>('[data-toc-panel]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-toc-toggle]');
    const closeButton = document.querySelector<HTMLButtonElement>('[data-toc-close]');
    const backdrop = document.querySelector<HTMLButtonElement>('[data-toc-backdrop]');
    if (!panel || !toggle || !closeButton || !backdrop) return;
    const tocPanel = panel;
    const tocToggle = toggle;
    const tocCloseButton = closeButton;
    const tocBackdrop = backdrop;

    let isOpen = false;

    function syncA11y() {
      const isDesktop = desktopMedia.matches;
      tocToggle.setAttribute('aria-expanded', String(!isDesktop && isOpen));
      if (isDesktop) {
        tocPanel.removeAttribute('aria-hidden');
        tocPanel.inert = false;
        document.body.classList.remove('toc-drawer-open');
        return;
      }
      tocPanel.setAttribute('aria-hidden', String(!isOpen));
      tocPanel.inert = !isOpen;
      document.body.classList.toggle('toc-drawer-open', isOpen);
    }

    function openDrawer() {
      if (desktopMedia.matches) return;
      isOpen = true;
      tocPanel.classList.add('is-open');
      tocBackdrop.classList.add('is-open');
      syncA11y();
      tocCloseButton.focus();
    }

    function closeDrawer(restoreFocus = true) {
      const wasOpen = isOpen;
      isOpen = false;
      tocPanel.classList.remove('is-open');
      tocBackdrop.classList.remove('is-open');
      syncA11y();
      if (wasOpen && restoreFocus) tocToggle.focus();
    }

    tocToggle.addEventListener('click', openDrawer);
    tocCloseButton.addEventListener('click', () => closeDrawer());
    tocBackdrop.addEventListener('click', () => closeDrawer());
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen) closeDrawer();
    });
    tocPanel.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((link) => {
      link.addEventListener('click', () => {
        if (!desktopMedia.matches) closeDrawer(false);
      });
    });
    desktopMedia.addEventListener('change', () => closeDrawer(false));
    syncA11y();

    const linkMap = new Map<string, HTMLElement>();
    tocPanel.querySelectorAll<HTMLElement>('[data-toc-link]').forEach((el) => {
      const slug = el.dataset.tocLink;
      if (slug) linkMap.set(slug, el);
    });

    function setActiveLink(slug: string) {
      linkMap.forEach((link, linkSlug) => {
        const isActive = linkSlug === slug;
        link.classList.toggle('is-active', isActive);
        if (isActive) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    }

    const hashSlug = decodeURIComponent(window.location.hash.slice(1));
    const initialSlug = linkMap.has(hashSlug) ? hashSlug : linkMap.keys().next().value;
    if (initialSlug) setActiveLink(initialSlug);

    if (linkMap.size > 0 && 'IntersectionObserver' in window) {
      // Bias the active zone toward the upper third so the link switches
      // before its heading reaches the top edge.
      const observer = new IntersectionObserver(
        (entries) => {
          const current = entries
            .filter((entry) => entry.isIntersecting && linkMap.has(entry.target.id))
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (current) setActiveLink(current.target.id);
        },
        { rootMargin: '-20% 0% -70% 0%' },
      );
      linkMap.forEach((_, slug) => {
        const heading = document.getElementById(slug);
        if (heading) observer.observe(heading);
      });
      activeObserver = observer;
    }
  }
  onReady(wireToc);
</script>

<style>
  .toc-toggle {
    position: fixed;
    top: 7rem;
    right: 0;
    z-index: 70;
    width: auto;
    min-width: 2.25rem;
    height: auto;
    min-height: 0;
    writing-mode: vertical-rl;
    white-space: nowrap;
    padding: 0.7rem 0.4rem;
    border: 1px solid var(--color-border);
    border-right: 0;
    border-radius: var(--radius) 0 0 var(--radius);
    background: var(--color-accent);
    color: var(--color-primary-content);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.08em;
    cursor: pointer;
  }
  .toc-toggle-short { display: none; }
  .toc-backdrop {
    position: fixed;
    inset: 0;
    z-index: 75;
    border: 0;
    background: rgba(0, 0, 0, 0.46);
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }
  .toc-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  .toc {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 80;
    width: min(20rem, 88vw);
    height: 100dvh;
    overflow-y: auto;
    border: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-card) 96%, var(--color-bg));
    padding: 1.25rem;
    font-size: 0.9rem;
    transform: translateX(100%);
    transition: transform 180ms ease;
    box-shadow: var(--shadow-float);
  }
  .toc.is-open {
    transform: translateX(0);
  }
  .toc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.7rem;
  }
  .toc-title {
    margin: 0;
    color: var(--color-fg);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
  }
  .toc-close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: transparent;
    color: var(--color-fg);
    font-size: 1.4rem;
    cursor: pointer;
  }
  /* The list is injected via set:html, so its descendants do not carry
     this component's scoped-style attribute — wrap selectors in :global()
     so the nested navigation rules still apply. */
  :global(.toc .toc-list) {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  :global(.toc > .toc-list) {
    --toc-rail-offset: -0.9rem;
    position: relative;
    padding-left: 1.2rem;
  }
  :global(.toc > .toc-list)::before {
    content: '';
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 0.3rem;
    width: 1px;
    background: color-mix(in srgb, var(--color-accent) 58%, var(--color-border));
  }
  :global(.toc .toc-list .toc-list) {
    --toc-rail-offset: -0.8rem;
    position: relative;
    margin: 0.08rem 0 0.16rem 0.8rem;
    padding-left: 1rem;
    font-size: 0.92em;
  }
  :global(.toc .toc-list .toc-list)::before {
    content: '';
    position: absolute;
    top: 0.68rem;
    bottom: 0.68rem;
    left: 0.2rem;
    width: 1px;
    background: color-mix(in srgb, var(--color-accent) 42%, var(--color-border));
  }
  :global(.toc .toc-list .toc-list .toc-list) {
    margin-left: 0.65rem;
    font-size: 0.9em;
  }
  :global(.toc .toc-item) {
    position: relative;
    margin: 0;
    line-height: 1.45;
  }
  :global(.toc .toc-item a) {
    position: relative;
    display: block;
    margin: 0;
    padding: 0.22rem 0;
    color: var(--color-muted);
    font-weight: 600;
    text-wrap: pretty;
    transition: color 160ms ease;
  }
  :global(.toc .toc-item a)::before {
    content: '';
    position: absolute;
    top: 50%;
    left: var(--toc-rail-offset);
    z-index: 1;
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-accent) 72%, var(--color-card));
    transform: translate(-50%, -50%);
    transition: width 160ms ease, height 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
  }
  :global(.toc .toc-item a:hover) {
    color: var(--color-accent);
    text-decoration: none;
  }
  :global(.toc .toc-item a:hover)::before {
    background: var(--color-accent);
  }
  :global(.toc .toc-item a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  :global(.toc .toc-item a.is-active) {
    color: var(--color-fg);
    font-weight: 700;
  }
  :global(.toc .toc-item a.is-active)::before {
    width: 0.68rem;
    height: 0.68rem;
    background: var(--color-accent);
    box-shadow:
      0 0 0 2px var(--color-card),
      0 0 0 3px color-mix(in srgb, var(--color-accent) 78%, transparent);
  }
  :global(body.toc-drawer-open) {
    overflow: hidden;
  }
  @media (max-width: 540px) {
    .toc-toggle {
      top: auto;
      right: max(0.75rem, env(safe-area-inset-right));
      bottom: max(0.75rem, env(safe-area-inset-bottom));
      min-width: 3rem;
      min-height: 3rem;
      writing-mode: horizontal-tb;
      padding: 0.55rem 0.75rem;
      border-right: 1px solid var(--color-border);
      border-radius: 999px;
      line-height: 1;
      box-shadow: var(--shadow-float);
    }
    .toc-toggle-full { display: none; }
    .toc-toggle-short { display: inline; }
  }
  @media (min-width: 90rem) {
    .toc-toggle,
    .toc-backdrop,
    .toc-close {
      display: none;
    }
    .toc {
      position: sticky;
      top: 6rem;
      z-index: auto;
      width: auto;
      height: auto;
      max-height: calc(100vh - 7rem);
      margin: 0;
      border-radius: var(--radius);
      padding: 1.25rem;
      transform: none;
      transition: none;
      box-shadow: none;
    }
    .toc-head {
      margin-bottom: 0.7rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .toc,
    .toc-backdrop,
    :global(.toc .toc-item a) {
      transition: none;
    }
  }
</style>
