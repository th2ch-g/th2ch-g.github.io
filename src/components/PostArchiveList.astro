---
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { tUi, type Lang } from '@/i18n/ui';
import { formatMonthDay, localeSlug } from '@/lib/content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  lang: Lang;
  yearHeadingLevel?: 'h2' | 'h3';
  size?: 'default' | 'large';
  largeTitles?: boolean;
}

const {
  posts,
  lang,
  yearHeadingLevel = 'h2',
  size = 'default',
  largeTitles = false,
} = Astro.props;

// Preserve the input order within each year. Callers pass posts sorted by
// publication date, so the output stays newest-first without client-side JS.
const byYear = new Map<number, CollectionEntry<'posts'>[]>();
posts.forEach((post) => {
  const year = post.data.pubDate.getUTCFullYear();
  const items = byYear.get(year) ?? [];
  items.push(post);
  byYear.set(year, items);
});
---
<div
  class:list={[
    'post-archive-list',
    {
      large: size === 'large',
      'large-titles': size === 'large' || largeTitles,
    },
  ]}
  data-post-list
>
  {Array.from(byYear.entries()).map(([year, items]) => (
    <section class="year" data-post-year>
      {yearHeadingLevel === 'h3' ? (
        <h3>{year} <span class="count-inline count-badge" data-year-count>{items.length}</span></h3>
      ) : (
        <h2>{year} <span class="count-inline count-badge" data-year-count>{items.length}</span></h2>
      )}
      <ul class="bare" data-year-items>
        {items.map((post) => (
          <li
            class="row"
            data-post-row
          >
            <time
              class="date muted"
              datetime={post.data.pubDate.toISOString()}
            >
              {formatMonthDay(post.data.pubDate)}
            </time>
            <a href={getRelativeLocaleUrl(lang, `/posts/${localeSlug(post.id)}`)}>
              <span>
                {post.data.title}
                {post.data.draft && <span class="draft-badge">{tUi('posts.draft')}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .year { margin-top: 1.5rem; }
  .year:first-child { margin-top: 0; }
  .year > h2,
  .year > h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--color-card);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .year > ul {
    border: 1px solid var(--color-border);
    border-top: 0;
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--color-bg);
  }
  .row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 0.5rem 1rem;
    padding: 0.625rem 1rem;
    align-items: baseline;
    border-bottom: 1px solid var(--color-border-muted);
    transition: background-color 160ms ease;
  }
  .row:last-child { border-bottom: 0; }
  .row:hover { background: var(--color-card); }
  .row > a {
    color: var(--color-fg);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }
  .row > a:hover { color: var(--color-accent); }
  .row[hidden] { display: none; }
  .date {
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
  }
  .draft-badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.02rem 0.4rem;
    border: 1px solid var(--color-warn);
    border-radius: 999px;
    color: var(--color-warn);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.4;
    vertical-align: middle;
  }
  .post-archive-list.large .year h3 { font-size: 1rem; }
  .post-archive-list.large .count-inline { font-size: 0.8em; }
  .post-archive-list.large .row { padding-block: 0.8rem; }
  .post-archive-list.large-titles .row > a {
    font-size: 1.05rem;
    line-height: 1.5;
  }
  .post-archive-list.large .date { font-size: 0.92rem; }
  @media (max-width: 540px) {
    .row { grid-template-columns: 1fr; gap: 0.1rem; }
    .date { font-size: 0.75rem; }
  }
</style>
