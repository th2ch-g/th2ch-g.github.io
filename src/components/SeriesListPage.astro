---
import Base from '@/layouts/Base.astro';
import PostArchiveList from './PostArchiveList.astro';
import LocaleContent from './LocaleContent.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { tUi, type Lang } from '@/i18n/ui';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from '@/lib/locale-url';
import { sortByDateDesc } from '@/lib/content';

interface Props {
  lang: Lang;
  name: string;
  posts: CollectionEntry<'posts'>[];
}
const { lang, name, posts } = Astro.props;
const heading = `${tUi('series.heading')}: ${name}`;
const displayPosts = sortByDateDesc(posts, 'pubDate');
---
<Base lang={lang} title={heading}>
  <Breadcrumbs
    lang={lang}
    items={[
      { label: tUi('nav.home'), href: getRelativeLocaleUrl(lang, '/') },
      { label: tUi('nav.posts'), href: getRelativeLocaleUrl(lang, '/posts') },
      { label: `${tUi('series.heading')}: ${name}` },
    ]}
  />
  <h1 class="count-heading">
    <span class="muted">{tUi('series.heading')}:</span> {name}
    <LocaleContent inline>
      <span slot="en" class="count-badge">{posts.filter((post) => post.data.lang.includes('en')).length}</span>
      <span slot="ja" class="count-badge">{posts.filter((post) => post.data.lang.includes('ja')).length}</span>
    </LocaleContent>
  </h1>
  <LocaleContent>
    <PostArchiveList slot="en" posts={displayPosts.filter((post) => post.data.lang.includes('en'))} lang="en" />
    <PostArchiveList slot="ja" posts={displayPosts.filter((post) => post.data.lang.includes('ja'))} lang="ja" />
  </LocaleContent>
</Base>

<style>
  h1 .muted {
    font-weight: 400;
    color: var(--color-muted);
    font-size: 0.7em;
    margin-right: 0.4rem;
  }
</style>
