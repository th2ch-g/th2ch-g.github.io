---
import Base from '@/layouts/Base.astro';
import PostArchiveList from './PostArchiveList.astro';
import { tUi, type Lang } from '@/i18n/ui';
import { getByLang, sortByDateDesc } from '@/lib/content';
import { getLocaleFileUrl } from '@/lib/locale-url';

interface Props { lang: Lang }
const { lang } = Astro.props;

const posts = sortByDateDesc(
  await getByLang('posts', lang),
  'pubDate',
);
---
<Base lang={lang} title={tUi('nav.posts')} image={getLocaleFileUrl(lang, '/og/posts.png')}>
  <h1 class="sr-only">{tUi('nav.posts')}</h1>
  {posts.length === 0 ? (
    <p class="muted">{tUi('list.empty')}</p>
  ) : (
    <PostArchiveList posts={posts} lang={lang} largeTitles />
  )}
</Base>
