---
import { tUi, type Lang } from '@/i18n/ui';
import { getCv } from '@/lib/content';
import { allCitations } from '@/lib/citations';
import { allBibtex } from '@/lib/bibtex';
import { render } from 'astro:content';
import { siGithub, siOrcid, siHuggingface } from 'simple-icons';
import { kaggleMonogram } from '@/lib/brand-icons';

interface Props { lang: Lang }
const { lang } = Astro.props;

const cv = await getCv(lang);
if (!cv) {
  throw new Error(`CV (${lang}) is missing. Add src/content/cv/${lang}.md`);
}
const { Content } = await render(cv);
const cvLinks = [
  cv.data.orcid
    ? { label: 'ORCID', url: `https://orcid.org/${cv.data.orcid}`, icon: siOrcid.path }
    : undefined,
  cv.data.github ? { label: 'GitHub', url: cv.data.github, icon: siGithub.path } : undefined,
  cv.data.kaggle ? { label: 'Kaggle', url: cv.data.kaggle, icon: kaggleMonogram } : undefined,
  cv.data.huggingface
    ? { label: 'Hugging Face', url: cv.data.huggingface, icon: siHuggingface.path }
    : undefined,
].filter((link): link is { label: string; url: string; icon: string } => Boolean(link));
---
  <section id="cv" class="cv-layout" aria-label={tUi('nav.cv')}>
    <div class="cv-content">
      <div class="cv-header">
        {cvLinks.length > 0 && (
          <nav aria-label="Profile links">
            <ul class="cv-profile-links">
              {cvLinks.map((link) => (
                <li>
                  <a class="btn btn-ghost btn-sm" href={link.url} target="_blank" rel="noopener noreferrer">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d={link.icon} />
                    </svg>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {/* CV toolbar. Copy-all and .bib actions are collapsed into
            one disclosure menu built client-side by the script below — the
            same affordance as the per-section copy menus. */}
        <div
          class="cv-header-actions"
          data-cv-actions
          data-label-all={tUi('cv.copy.all')}
          data-label-bib={tUi('cv.copy.bib')}
          data-menu-aria={tUi('cv.actions.menu.aria')}
        ></div>
      </div>
      <div
        class="prose cv-prose"
        data-cv-lang={lang}
        data-copy-label={tUi('code.copy')}
        data-citations={JSON.stringify(allCitations)}
        data-citation-label={tUi('citation.label')}
        data-citation-source={tUi('citation.source')}
        data-bibtex={JSON.stringify(allBibtex)}
        data-bibtex-label={tUi('cv.copy.bibtex')}
        data-bibtex-aria={tUi('cv.copy.bibtex.aria')}
        data-section-bibtex-label={tUi('cv.copy.bibtex.section')}
        data-section-copy-label={tUi('cv.copy.section')}
        data-section-menu-label={tUi('cv.copy.section.menu')}
        data-section-menu-aria={tUi('cv.copy.section.menu.aria')}
        data-item-text-label={tUi('cv.copy.item.text')}
      ><Content /></div>
    </div>
  </section>

<script>
  import { onReady } from '@/lib/dom-ready';
  import { setupCv } from '@/lib/cv/init';

  onReady(setupCv);
</script>

<style>
  .cv-layout,
  .cv-content {
    min-width: 0;
  }
  .cv-layout {
    margin-top: 0;
    scroll-margin-top: 5rem;
  }
  .cv-header {
    display: flex;
    /* Reserve the toolbar before its client-side copy menu is attached. */
    min-height: 2rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .cv-header-actions {
    display: flex;
    min-width: 3rem;
    min-height: 2rem;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-left: auto;
  }
  .cv-header > nav { flex: 1; min-width: 0; }
  .cv-profile-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  .cv-profile-links a.btn {
    color: var(--color-fg);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.5;
    padding: 0.375rem 0.5rem;
    text-underline-offset: 0.15em;
  }
  .cv-profile-links svg { flex-shrink: 0; color: var(--color-muted); }
  .cv-profile-links a.btn:hover,
  .cv-profile-links a.btn:focus-visible {
    color: var(--color-accent);
  }
  .cv-profile-links li:not(:last-child)::after { content: none; }
  /* Page-level toolbar menu (copy all / copy .bib). Built
     client-side and appended into `.cv-header-actions`, which is OUTSIDE
     `.cv-prose`, so it carries no scoped-style hash — the menu selectors must
     be :global() and live here rather than reusing the `.cv-prose`-scoped
     copy-menu rules. Unlike the hover-revealed section/per-item triggers, this
     is the page toolbar, so it stays fully visible. `.cv-header-btn` is the
     chip skin (mirrors the former `.cv-action`); `.cv-menu-trigger` adds the
     inline-flex layout + caret. */
  .cv-header-actions :global(.cv-menu) {
    position: relative;
    display: inline-block;
  }
  .cv-header-actions :global(.cv-header-btn) {
    min-height: 2rem;
    font-size: 0.875rem;
    padding: 0.3125rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-field);
    color: var(--color-fg);
    background: var(--color-button);
    box-shadow: var(--shadow-soft);
    cursor: pointer;
    font-family: inherit;
    transition: border-color 120ms ease, background-color 120ms ease;
  }
  .cv-header-actions :global(.cv-menu-trigger) {
    display: inline-flex;
    align-items: center;
    list-style: none;
    white-space: nowrap;
  }
  .cv-header-actions :global(.cv-menu-trigger svg) {
    width: 0.95rem;
    height: 0.95rem;
    display: block;
  }
  .cv-header-actions :global(.cv-menu-trigger::-webkit-details-marker) {
    display: none;
  }
  .cv-header-actions :global(.cv-menu-trigger::after) {
    content: '▾';
    margin-left: 0.3rem;
    font-size: 0.7em;
    transition: transform 160ms ease;
  }
  .cv-header-actions :global(.cv-menu[open] .cv-menu-trigger),
  .cv-header-actions :global(.cv-menu-trigger:hover),
  .cv-header-actions :global(.cv-menu-trigger:focus-visible) {
    background: var(--color-hover);
    border-color: var(--color-border-strong);
  }
  .cv-header-actions :global(.cv-menu.is-copied .cv-menu-trigger) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .cv-header-actions :global(.cv-menu.is-failed .cv-menu-trigger) {
    color: var(--color-error);
    border-color: var(--color-error);
  }
  .cv-header-actions :global(.cv-menu[open] .cv-menu-trigger::after) {
    transform: rotate(180deg);
  }
  /* Hide the caret while the trigger is flashing copy feedback. */
  .cv-header-actions :global(.cv-menu.is-copied .cv-menu-trigger::after),
  .cv-header-actions :global(.cv-menu.is-failed .cv-menu-trigger::after) {
    display: none;
  }
  .cv-header-actions :global(.cv-menu-list) {
    position: absolute;
    right: 0;
    top: calc(100% + 0.3rem);
    z-index: 10;
    display: flex;
    flex-direction: column;
    width: max-content;
    padding: 0.5rem;
    background: var(--color-overlay);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-overlay);
    box-shadow: var(--shadow-float);
  }
  .cv-header-actions :global(.cv-menu-item) {
    display: block;
    width: 100%;
    height: auto;
    min-height: 2rem;
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: left;
    white-space: nowrap;
    padding: 0.375rem 0.5rem;
    border: none;
    border-radius: calc(var(--radius) - 1px);
    background: transparent;
    color: var(--color-fg);
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
  }
  .cv-header-actions :global(.cv-menu-item:hover),
  .cv-header-actions :global(.cv-menu-item:focus-visible) {
    background: var(--color-hover);
    color: var(--color-fg);
    text-decoration: none;
  }
  /* Suppress the whole toolbar in printed output. */
  @media print {
    .cv-layout { margin-top: 0; }
    .cv-header { min-height: 0; margin-bottom: 1rem; padding-bottom: 0.5rem; }
    .cv-header-actions { display: none; }
  }

  /* Per-item copy buttons. Markdown rendered by <Content /> doesn't carry
     this component's scope hash, so the descendant selectors must be
     :global(). The actions container is appended by the inline script. */
  .cv-prose > :global(:is(ol, ul) > li) {
    position: relative;
    /* Reserve action space before JavaScript adds copy controls, so text
       keeps the same line breaks from the first paint. */
    padding-right: 3.5rem;
  }
  /* Draw presenter marks independently of platform-specific symbol fonts.
     Keep the original character in the DOM for selection and copying. */
  .cv-prose :global(.cv-presenter-marker) {
    display: inline-block;
    box-sizing: border-box;
    width: 0.65em;
    height: 0.65em;
    border: 1px solid currentColor;
    border-radius: 50%;
    vertical-align: 0.05em;
    overflow: hidden;
    white-space: nowrap;
    text-indent: 100%;
  }
  /* WCAG 2.4.4 / axe `link-in-text-block`: publication entries embed DOI
     links inside the citation prose, so color alone is not enough to
     distinguish them. Underline the in-list anchors. */
  .cv-prose :global(li.cv-copyable a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .cv-prose :global(.cv-copy-actions) {
    position: absolute;
    top: 0.05rem;
    right: 0;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .cv-prose :global(.cv-copy-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1.2;
    padding: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-field);
    color: var(--color-fg);
    background: var(--color-bg);
    font-family: inherit;
    cursor: pointer;
    opacity: 0;
    transition: opacity 160ms ease, color 160ms ease, border-color 160ms ease;
  }
  /* Keep publication copy menus discoverable without requiring hover. Other
     CV entries retain the quieter hover-only copy affordance. */
  .cv-prose :global(li.cv-has-bibtex .cv-copy-btn) {
    opacity: 0.7;
  }
  .cv-prose :global(li.cv-copyable:hover .cv-copy-btn),
  .cv-prose :global(li.cv-copyable:focus-within .cv-copy-btn),
  .cv-prose :global(.cv-copy-btn:focus-visible),
  .cv-prose :global(.cv-copy-btn.is-copied),
  .cv-prose :global(.cv-copy-btn.is-failed) {
    opacity: 1;
  }
  .cv-prose :global(.cv-copy-btn:hover),
  .cv-prose :global(.cv-copy-btn.is-copied) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .cv-prose :global(.cv-copy-btn.is-failed) {
    color: var(--color-error);
    border-color: var(--color-error);
  }
  /* Touch devices have no hover — keep the buttons faintly visible. */
  @media (hover: none) {
    .cv-prose :global(.cv-copy-btn) { opacity: 0.55; }
  }
  /* Don't render the buttons in printed output. */
  @media print {
    .cv-prose > :global(:is(ol, ul) > li) { padding-right: 0; }
    .cv-prose :global(.cv-copy-actions) { display: none; }
  }

  /* Reserve room at the heading's right edge so the absolutely-positioned
     actions never sit over the (often long) section title — the same
     strategy as `li.cv-copyable` above. One trigger/button is narrow, so a
     single reservation suffices; zeroed in print further down so printed
     headings don't carry phantom right padding. */
  .cv-prose :global(:is(h1, h2, h3, h4, h5, h6)) {
    padding-right: 4rem;
    /* prose.css only sets `position: relative` on h2/h3/h4 (for the
       heading-anchor #). The class lands on whatever heading level the CV
       uses, so anchor it here too — an h1 section heading would otherwise
       let the actions escape to the nearest positioned ancestor. */
    position: relative;
  }

  /* Section-level bulk-copy buttons appended inside every heading that owns a
     following list. The heading is `position: relative` (see above), so the
     actions group can be absolutely anchored to its right edge without
     flexing the heading itself — keeping the heading's normal block flow
     intact and avoiding empty-row reflow on narrow viewports.

     Buttons stay invisible until the heading is hovered/focused, matching
     the per-item button affordance. `is-copied` / `is-failed` keep the
     button visible during the 1.8s feedback window. */
  .cv-prose :global(.cv-section-actions) {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    /* `transform` makes this a stacking context, so the open menu's own
       z-index is scoped inside it. Lift the whole group above the section
       list below — otherwise the per-item copy buttons (later in the DOM)
       paint over the dropdown and steal its clicks. */
    z-index: 20;
  }
  .cv-prose :global(.cv-section-btn) {
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.3;
    padding: 0.2rem 0.6rem;
    border: 0;
    border-radius: var(--radius-field);
    color: var(--color-fg);
    background: transparent;
    box-shadow: none;
    font-family: inherit;
    cursor: pointer;
    opacity: 0;
    transition: opacity 160ms ease, border-color 160ms ease, color 160ms ease;
  }
  .cv-prose :global(.cv-section-heading:hover .cv-section-btn),
  .cv-prose :global(.cv-section-heading:focus-within .cv-section-btn),
  .cv-prose :global(.cv-section-btn:focus-visible),
  .cv-prose :global(.cv-section-btn.is-copied),
  .cv-prose :global(.cv-section-btn.is-failed),
  .cv-prose :global(.cv-menu[open] .cv-menu-trigger),
  .cv-prose :global(.cv-menu.is-copied .cv-menu-trigger),
  .cv-prose :global(.cv-menu.is-failed .cv-menu-trigger) {
    opacity: 1;
  }
  .cv-prose :global(.cv-section-btn:hover),
  .cv-prose :global(.cv-section-btn.is-copied) {
    color: var(--color-accent);
    background: transparent;
    box-shadow: none;
    text-decoration: none;
  }
  .cv-prose :global(.cv-section-btn.is-failed) {
    color: var(--color-error);
    border-color: var(--color-error);
  }

  /* Copy menu: one trigger (<summary>) that drops a small popover of copy
     actions. Shared by section headings and individual list entries. The
     list is absolutely positioned so opening it never reflows the row. */
  .cv-prose :global(.cv-menu) {
    position: relative;
    display: inline-block;
    /* Neutralize the generic `.prose details` card styling (prose.css):
       the menu is an inline trigger, not a bordered block. */
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
    background: none;
    box-shadow: none;
  }
  .cv-prose :global(.cv-menu[open]) {
    padding: 0;
  }
  /* Suppress the generic `.prose summary::before` chevron — the trigger
     carries its own caret via ::after. */
  .cv-prose :global(.cv-menu-trigger::before) {
    display: none;
  }
  .cv-prose :global(.cv-menu-trigger) {
    display: inline-flex;
    align-items: center;
    list-style: none;
    white-space: nowrap;
    /* Icon trigger: override the sizing-class text padding with a square-ish
       box that still leaves room for the ::after caret. */
    padding: 0.25rem 0.4rem;
  }
  /* Copy icon inside per-item buttons, menu triggers, and the single-action
     section copy button. Sized in rem so the chip's font-size is irrelevant. */
  .cv-prose :global(.cv-copy-btn svg),
  .cv-prose :global(.cv-menu-trigger svg),
  .cv-prose :global(.cv-section-copy svg) {
    width: 0.95rem;
    height: 0.95rem;
    display: block;
  }
  /* The single-action section copy is an icon button (no text label): center
     the glyph and replace the .cv-section-btn text padding with a square box,
     matching the per-item .cv-copy-btn. */
  .cv-prose :global(.cv-section-copy) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    min-width: 2rem;
    height: 2rem;
    min-height: 2rem;
    padding: 0;
  }
  .cv-prose :global(.cv-copy-btn:not(.cv-menu-trigger)) {
    width: 2rem;
    min-width: 2rem;
    height: 2rem;
    min-height: 2rem;
    padding: 0;
  }
  .cv-prose :global(.cv-menu-trigger::-webkit-details-marker) {
    display: none;
  }
  .cv-prose :global(.cv-menu-trigger::after) {
    content: '▾';
    margin-left: 0.3rem;
    font-size: 0.7em;
    transition: transform 160ms ease;
  }
  .cv-prose :global(.cv-menu[open] .cv-menu-trigger::after) {
    transform: rotate(180deg);
  }
  /* Hide the caret while the trigger is flashing copy feedback. */
  .cv-prose :global(.cv-menu.is-copied .cv-menu-trigger::after),
  .cv-prose :global(.cv-menu.is-failed .cv-menu-trigger::after) {
    display: none;
  }
  .cv-prose :global(.cv-menu.is-copied .cv-menu-trigger) {
    color: var(--color-accent);
  }
  .cv-prose :global(.cv-menu.is-failed .cv-menu-trigger) {
    color: var(--color-error);
  }
  .cv-prose :global(.cv-menu-list) {
    position: absolute;
    right: 0;
    top: calc(100% + 0.3rem);
    z-index: 10;
    display: flex;
    flex-direction: column;
    width: max-content;
    padding: 0.5rem;
    background: var(--color-overlay);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-overlay);
    box-shadow: var(--shadow-float);
  }
  .cv-prose :global(.cv-menu-item) {
    display: block;
    width: 100%;
    height: auto;
    min-height: 2rem;
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: left;
    white-space: nowrap;
    padding: 0.375rem 0.5rem;
    border: none;
    border-radius: calc(var(--radius) - 1px);
    background: transparent;
    color: var(--color-fg);
    font-family: inherit;
    cursor: pointer;
  }
  .cv-prose :global(.cv-menu-item:hover),
  .cv-prose :global(.cv-menu-item:focus-visible) {
    background: var(--color-hover);
    color: var(--color-fg);
  }

  /* Touch devices have no hover — keep the buttons faintly visible, same
     as the per-item copy buttons. */
  @media (hover: none) {
    .cv-prose :global(.cv-section-btn) { opacity: 0.55; }
  }
  @media print {
    .cv-prose :global(:is(h1, h2, h3, h4, h5, h6)) { padding-right: 0; }
    .cv-prose :global(.cv-section-actions) { display: none; }
  }

  /* CrossRef cited-by badge appended next to DOI links by the script above.
     Kept visually quiet so it sits next to a paper title without competing
     with the link. Hidden in print because the count goes stale between
     rebuilds. */
  .cv-prose :global(.citation-badge) {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0 0.4rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-muted);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    vertical-align: 0.05em;
    user-select: none;
    white-space: nowrap;
  }
  @media print {
    .cv-prose :global(.citation-badge) { display: none; }
  }

</style>
