---
import { tUi, type Lang } from '@/i18n/ui';
import { getRelativeLocaleUrl } from '@/lib/locale-url';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Build the share URL against Astro.site (production host) so links shared
// from a dev preview still resolve to the public page, not localhost.
const shareUrl = new URL(getRelativeLocaleUrl(lang, Astro.url.pathname), Astro.site).toString();
---
<div class="share" aria-label={tUi('share.title')}>
  <span class="share-label">{tUi('share.title')}</span>
  <ul class="share-list">
    <li class="share-copy-wrap">
      {/* The toast is positioned above the button via CSS. `aria-live="polite"`
          announces the message to screen readers without interrupting other
          speech. `pointer-events: none` keeps it from blocking re-clicks. */}
      <span class="share-toast" data-share-toast aria-live="polite" hidden></span>
      <button
        type="button"
        class="share-btn share-copy btn btn-circle btn-sm"
        data-share-url={shareUrl}
        data-label-copy={tUi('share.copy')}
        data-label-copied={tUi('share.copied')}
        data-label-failed={tUi('share.copy.failed')}
        aria-label={tUi('share.copy')}
        title={tUi('share.copy')}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 1 0-7.07-7.07l-1.5 1.5" />
          <path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 1 0 7.07 7.07l1.5-1.5" />
        </svg>
      </button>
    </li>
  </ul>
</div>

<script>
  import { wireShareCopyButtons } from '@/lib/share-copy';
  wireShareCopyButtons();
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 5rem 0 1.5rem;
  }
  .share-label {
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .share-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-field);
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-muted);
    cursor: pointer;
    transition: border-color 160ms ease, background-color 160ms ease;
  }
  .share-btn:hover,
  .share-btn:focus-visible {
    border-color: currentColor;
    text-decoration: none;
    background: var(--color-hover);
  }
  .share-copy:hover,
  .share-copy:focus-visible {
    color: var(--color-accent);
  }
  .share-btn.is-copied {
    color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }
  .share-btn.is-failed {
    color: var(--color-warn);
    border-color: var(--color-warn);
  }

  /* Anchor the toast to the copy button's column so it floats directly
     above. `position: relative` on the wrapper provides the containing
     block; `z-index: 1` keeps it above adjacent buttons during fade. */
  .share-copy-wrap {
    position: relative;
  }
  .share-toast {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translate(-50%, 4px);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius);
    background: var(--color-accent);
    color: var(--color-bg);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
    transition: opacity 180ms ease, transform 180ms ease;
    z-index: 1;
  }
  /* Triangle pointer: a small filled square rotated 45° and clipped by
     the toast's overflow boundary at the bottom edge. Color matches the
     toast background so it reads as one shape. */
  .share-toast::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    background: inherit;
    transform: translateX(-50%) rotate(45deg);
  }
  .share-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .share-toast.is-error {
    background: var(--color-warn);
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .share-btn { transition: none; }
    .share-btn:hover,
    .share-btn:focus-visible { transform: none; }
    /* Skip the slide-up; opacity-only transition is enough feedback
       without violating the user's motion preference. */
    .share-toast { transition: opacity 180ms ease; transform: translate(-50%, 0); }
    .share-toast.is-visible { transform: translate(-50%, 0); }
  }
</style>
