---
import Base from '@/layouts/Base.astro';
import { tUi } from '@/i18n/ui';

// GitHub Pages serves a single `/404.html` regardless of the requested
// content locale. The interface stays English and offers both content homes.
//
// availableLocales={['en']}: there is no /ja/404 route (GitHub Pages only
// serves the root 404.html), so the language switcher and hreflang must NOT
// advertise /ja/404 — it would be a dead link. The explicit links below
// still expose both content locales.
---
<Base lang="en" title="404 — Not Found" availableLocales={['en']}>
  <h1 class="big-404">404</h1>
  <section>
    <h2>{tUi('404.title')}</h2>
    <p>{tUi('404.message')}</p>
    <p><a href="/">{tUi('404.home.en')} →</a></p>
    <p><a href="/ja/">{tUi('404.home.ja')} →</a></p>
  </section>
</Base>

<style>
  .big-404 {
    font-size: clamp(4rem, 18vw, 8rem);
    font-weight: 800;
    margin: 0.5rem 0 0.25rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    line-height: 1;
  }
</style>
