---
import { tUi, type Lang } from '@/i18n/ui';

interface Props { lang: Lang }
---
<dialog class="shortcuts-dialog" data-shortcuts-dialog aria-label={tUi('shortcuts.title')}>
  <div class="shortcuts-shell modal-box">
    <h2>{tUi('shortcuts.title')}</h2>
    <dl class="shortcuts-list">
      <dt><kbd>/</kbd></dt><dd>{tUi('shortcuts.search')}</dd>
      <dt><kbd>⌘</kbd> + <kbd>K</kbd></dt><dd>{tUi('shortcuts.search')}</dd>
      <dt><kbd>g</kbd> <kbd>h</kbd></dt><dd>{tUi('shortcuts.go.home')}</dd>
      <dt><kbd>g</kbd> <kbd>b</kbd></dt><dd>{tUi('shortcuts.go.posts')}</dd>
      <dt><kbd>g</kbd> <kbd>p</kbd></dt><dd>{tUi('shortcuts.go.photos')}</dd>
      <dt><kbd>g</kbd> <kbd>c</kbd></dt><dd>{tUi('shortcuts.go.cv')}</dd>
      <dt><kbd>?</kbd></dt><dd>{tUi('shortcuts.help')}</dd>
      <dt><kbd>Esc</kbd></dt><dd>{tUi('shortcuts.close')}</dd>
    </dl>
    <button type="button" class="shortcuts-close btn btn-outline btn-primary btn-sm" data-shortcuts-close>{tUi('shortcuts.close')}</button>
  </div>
</dialog>

<script>
  import { wireShortcuts } from '@/lib/shortcuts';
  wireShortcuts();
</script>

<style>
  .shortcuts-dialog {
    border: none;
    padding: 0;
    background: transparent;
    max-width: min(440px, 100vw - 2rem);
    width: 100%;
  }
  .shortcuts-dialog::backdrop {
    background: var(--color-scrim);
  }
  .shortcuts-shell {
    background: var(--color-overlay);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-overlay);
    padding: 1rem;
    box-shadow: var(--shadow-float);
  }
  .shortcuts-shell h2 { margin-top: 0; font-size: 1rem; }
  .shortcuts-list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.4rem 1rem;
    margin: 0.5rem 0 1rem;
    font-size: 0.875rem;
  }
  .shortcuts-list dt {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    color: var(--color-muted);
  }
  .shortcuts-list dt kbd {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.05rem 0.4rem;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    box-shadow: inset 0 -1px 0 var(--color-border);
    color: var(--color-fg);
  }
  .shortcuts-list dd { margin: 0; }
  .shortcuts-close {
    min-height: 2rem;
    margin-top: 0.5rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-button);
    color: var(--color-fg);
    font-size: 0.875rem;
    box-shadow: var(--shadow-soft);
    cursor: pointer;
  }
  .shortcuts-close:hover,
  .shortcuts-close:focus-visible {
    border-color: var(--color-border-strong);
    background: var(--color-hover);
    color: var(--color-fg);
  }
  .shortcuts-close:active { background: var(--color-button-active); }
</style>
