---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { tUi, type Lang } from '@/i18n/ui';
import { getProfileMeta } from '@/lib/content';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';

interface Props {
  lang: Lang;
  // Forwarded to LanguageSwitcher: which locales this page exists in, so a
  // page without a translated twin doesn't render a switch link that 404s.
  availableLocales?: Lang[];
}
const { lang, availableLocales } = Astro.props;

const meta = await getProfileMeta(lang);

// Navigation and all other interface labels are intentionally English in
// both content locales.
// Entries use prefix matching so that detail routes like /posts/foo keep the
// parent section highlighted. `match: 'exact'` stays available for any future
// entry whose href would otherwise prefix-match unrelated paths (notably `/`,
// which is why Home is not listed here — the brand link covers it).
// `external: true` items live off-site (none currently); these open in a new
// tab and never receive an active state since their href is on a different
// origin.
type NavItem =
  | { href: string; label: string; match: 'exact' | 'prefix'; external?: false }
  | { href: string; label: string; external: true };

const items: NavItem[] = [
  { href: getRelativeLocaleUrl(lang, '/posts'), label: tUi('nav.posts'), match: 'prefix' },
  { href: getRelativeLocaleUrl(lang, '/cv'), label: tUi('nav.cv'), match: 'prefix' },
  { href: getRelativeLocaleUrl(lang, '/gallery'), label: tUi('nav.photos'), match: 'prefix' },
  { href: getRelativeLocaleUrl(lang, '/contact'), label: tUi('nav.contact'), match: 'prefix' },
];

const withSlash = (p: string) => (p.endsWith('/') ? p : p + '/');
const current = withSlash(Astro.url.pathname);

function isActive(href: string, match: 'exact' | 'prefix'): boolean {
  const target = withSlash(href);
  return match === 'exact' ? current === target : current === target || current.startsWith(target);
}

// The brand is the only Home affordance in the header (there is no "Home" nav
// item), so it carries the accessible name and the `aria-current` marker that
// the nav list would otherwise provide for `/`.
const homeHref = getRelativeLocaleUrl(lang, '/');
const atHome = current === withSlash(homeHref);
---
<header class="site-header">
  <div class="inner">
    {/* Icon-only brand. The image is decorative (`alt=""` + `aria-hidden`), so
        the link would have no accessible name on its own — `aria-label` supplies
        it and keeps axe's `link-name` (wcag2a) satisfied. */}
    <a class="brand" href={homeHref} aria-label={tUi('nav.home')} aria-current={atHome ? 'page' : undefined}>
      {meta.icon && (
        <img
          class="brand-icon"
          src={meta.icon}
          alt=""
          width="28"
          height="28"
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />
      )}
    </a>
    <nav id="primary-nav" data-nav data-open="false" aria-label="Primary">
      <ul class="bare nav-list">
        {items.map((item) => {
          const external = item.external === true;
          const active = !external && isActive(item.href, item.match);
          return (
            <li>
              <a
                href={item.href}
                class:list={{ active }}
                data-label={item.label}
                aria-current={active ? 'page' : undefined}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >{item.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>
    <Search lang={lang} />
    <ThemeToggle lang={lang} />
    <LanguageSwitcher lang={lang} availableLocales={availableLocales} />
    <button
      type="button"
      class="nav-toggle btn btn-ghost btn-sm"
      aria-controls="primary-nav"
      aria-expanded="false"
      aria-label={tUi('nav.menu')}
      data-nav-toggle
    >
      <span class="bar" aria-hidden="true"></span>
      <span class="bar" aria-hidden="true"></span>
      <span class="bar" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  import { wireNavToggles } from '@/lib/nav-toggle';
  wireNavToggles();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-card);
  }
  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    min-height: 4rem;
    padding: 0.75rem 1.25rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--color-fg);
    flex-shrink: 0;
  }
  .brand-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    flex: 0 0 auto;
  }
  nav { flex: 1; }
  .nav-list {
    display: flex;
    gap: 0.25rem;
    padding: 0;
  }
  .nav-list a {
    position: relative;
    display: inline-block;
    color: var(--color-fg);
    font-size: 0.875rem;
    line-height: 1.5;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-field);
    transition: background-color 160ms ease;
  }
  /* Reserve bold text width so the active item never shifts its neighbors. */
  .nav-list a::after {
    content: attr(data-label);
    display: block;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    font-weight: 600;
    pointer-events: none;
  }
  .nav-list a:hover {
    background: var(--color-hover);
    text-decoration: none;
  }
  .nav-list a.active { font-weight: 600; }
  .nav-toggle {
    display: none;
    position: relative;
    flex: 0 0 2rem;
    width: 2rem;
    height: 2rem;
    min-height: 2rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-field);
    color: var(--color-fg);
    cursor: pointer;
  }
  .nav-toggle:hover { background: var(--color-hover); border-color: var(--color-border-strong); }
  .nav-toggle:active { background: var(--color-button-active); }
  .nav-toggle .bar {
    position: absolute;
    left: 0.45rem;
    right: 0.45rem;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 160ms ease, opacity 160ms ease;
  }
  .nav-toggle .bar:nth-child(1) { top: 0.55rem; }
  .nav-toggle .bar:nth-child(2) { top: 0.9rem; }
  .nav-toggle .bar:nth-child(3) { top: 1.25rem; }
  .nav-toggle[aria-expanded="true"] .bar:nth-child(1) {
    transform: translateY(0.35rem) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .bar:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] .bar:nth-child(3) {
    transform: translateY(-0.35rem) rotate(-45deg);
  }
  @media (max-width: 720px) {
    .inner {
      position: relative;
      gap: 0.5rem;
      min-height: 3.6rem;
      padding: 0.65rem 0.75rem;
    }
    .brand { flex: 1; min-width: 0; }
    .nav-toggle { display: inline-flex; }
    nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 0.5rem 0.75rem;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      background: var(--color-card);
      box-shadow: var(--shadow-float);
    }
    nav[data-open="false"] { display: none; }
    .nav-list { flex-direction: column; gap: 0.25rem; }
    .nav-list a { width: 100%; padding: 0.65rem 0.85rem; }
    .nav-list a.active { background: var(--color-hover); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-list a,
    .nav-toggle .bar { transition: none; }
  }
</style>
