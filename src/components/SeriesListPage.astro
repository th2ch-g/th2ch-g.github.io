---
import Base from '@/layouts/Base.astro';
import PostArchiveList from './PostArchiveList.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { tUi, type Lang } from '@/i18n/ui';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { sortByDateDesc } from '@/lib/content';

interface Props {
  lang: Lang;
  name: string;
  posts: CollectionEntry<'posts'>[];
}
const { lang, name, posts } = Astro.props;
const heading = `${tUi('series.heading')}: ${name}`;
const displayPosts = sortByDateDesc(posts, 'pubDate');
---
<Base lang={lang} title={heading}>
  <Breadcrumbs
    lang={lang}
    items={[
      { label: tUi('nav.home'), href: getRelativeLocaleUrl(lang, '/') },
      { label: tUi('nav.posts'), href: getRelativeLocaleUrl(lang, '/posts') },
      { label: `${tUi('series.heading')}: ${name}` },
    ]}
  />
  <h1>
    <span class="muted">{tUi('series.heading')}:</span> {name}
    {posts.length > 0 && <span class="count-badge">{posts.length}</span>}
  </h1>
  {posts.length === 0 ? (
    <p class="muted">{tUi('list.empty')}</p>
  ) : (
    <PostArchiveList posts={displayPosts} lang={lang} />
  )}
</Base>

<style>
  h1 .muted {
    font-weight: 400;
    color: var(--color-muted);
    font-size: 0.7em;
    margin-right: 0.4rem;
  }
</style>
