---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { tUi, type Lang } from '@/i18n/ui';
import { getLegalByLang, getProfileMeta } from '@/lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const meta = await getProfileMeta(lang);
const year = new Date().getFullYear();
// repoUrl is only defined when profile.yaml supplies a `repo:` slug.
// Without it the GH source / license link block is hidden entirely
// rather than rendering broken `https://github.com/` links.
const repoUrl = meta.repo ? `https://github.com/${meta.repo}` : undefined;
// Legal docs auto-discovered from src/content/legal/<lang>/. Drop a new
// markdown file there and it appears in the footer + sitemap with no further
// code change. Footer labels prefer the English mirror's frontmatter title;
// the destination still follows the current content locale.
const legalDocs = await getLegalByLang(lang);
const englishLegalTitles = new Map(
  (await getLegalByLang('en')).map((doc) => [doc.slug, doc.title]),
);
const legalLinks = legalDocs.map((doc) => ({
  slug: doc.slug,
  // Legal pages are content and keep their localized headings, but footer
  // navigation is English-only. A humanized slug preserves that contract if
  // a locale-specific page temporarily has no English mirror.
  label: englishLegalTitles.get(doc.slug)
    ?? doc.slug.split('-').map((part) => part.charAt(0).toUpperCase() + part.slice(1)).join(' '),
})).sort((a, b) => a.label.localeCompare(b.label, 'en'));
const sitemapUrl = getRelativeLocaleUrl(lang, '/sitemap');
const sitemapLabel = tUi('sitemap.title');
---
<footer class="site-footer">
  <div class="inner">
    <p class="muted">© {year} {meta.siteHandle}</p>
    <p class="muted">
      {legalLinks.map((doc) => (
        <>
          <a href={getRelativeLocaleUrl(lang, `/${doc.slug}`)}>{doc.label}</a>
          <span class="sep">·</span>
        </>
      ))}
      <a href={sitemapUrl}>{sitemapLabel}</a>
      {repoUrl && (
        <>
          <span class="sep">·</span>
          <a href={`${repoUrl}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">Code license: MIT</a>
          <span class="sep">·</span>
          <a href={`${repoUrl}/blob/main/LICENSE-content`} target="_blank" rel="noopener noreferrer">Content license: CC BY 4.0</a>
          <span class="sep">·</span>
          <a href={repoUrl} target="_blank" rel="noopener noreferrer">Source</a>
        </>
      )}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
    padding: 1.25rem;
  }
  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
  }
  .sep {
    margin: 0 0.4rem;
    color: var(--color-muted);
  }
</style>
