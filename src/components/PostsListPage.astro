---
import Base from '@/layouts/Base.astro';
import PostArchiveList from './PostArchiveList.astro';
import { t, tEn, type Lang } from '@/i18n/ui';
import { collectTags, getPublishedByLang, sortByDateDesc } from '@/lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;

const posts = sortByDateDesc(
  await getPublishedByLang('posts', lang, { includeDevDrafts: true }),
  'pubDate',
);
const allTags = collectTags(posts);
---
<Base lang={lang} title={tEn('nav.posts')} image={lang === 'en' ? '/en/og/posts.png' : '/og/posts.png'}>
  <h1>
    {t(lang, 'nav.posts')}
    {posts.length > 0 && <span class="count-badge">{posts.length}</span>}
  </h1>
  {posts.length === 0 ? (
    <p class="muted">{t(lang, 'list.empty')}</p>
  ) : (
    <>
      <div class="filter-bar" data-posts-filter>
        {allTags.length > 0 && (
          <div
            class="tag-chips"
            role="group"
            aria-label={t(lang, 'filter.label')}
            data-collapsible
            data-more-label={t(lang, 'filter.more')}
            data-less-label={t(lang, 'filter.less')}
          >
            <button type="button" class="chip is-active" data-facet="tag" data-value="">
              {t(lang, 'filter.all')}
            </button>
            {allTags.map((tag) => (
              <button type="button" class="chip" data-facet="tag" data-value={tag}>
                #{tag}
              </button>
            ))}
          </div>
        )}
        <button
          type="button"
          class="sort-toggle"
          data-sort-toggle
          data-label-newest={t(lang, 'sort.newest')}
          data-label-oldest={t(lang, 'sort.oldest')}
          aria-label={t(lang, 'sort.newest')}
        >
          <span class="sort-label">{t(lang, 'sort.newest')}</span>
          <span class="sort-arrow" aria-hidden="true">↓</span>
        </button>
      </div>
      <PostArchiveList posts={posts} lang={lang} largeTitles />
      <p class="muted empty-msg" hidden data-empty-msg>{t(lang, 'list.empty.filter')}</p>
    </>
  )}
</Base>

<script>
  import { setupPostListFilter } from '@/lib/post-list-filter';
  import { onReady } from '@/lib/dom-ready';

  onReady(setupPostListFilter);
</script>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: flex-start;
    justify-content: space-between;
    margin: 0.5rem 0 1.5rem;
  }
  .tag-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag-chips :global(.chip) {
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-card);
    color: var(--color-muted);
    font-size: 0.8rem;
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }
  .tag-chips :global(.chip:hover),
  .tag-chips :global(.chip:focus-visible) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .tag-chips :global(.chip.is-active) {
    color: var(--color-bg);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }
  .tag-chips :global(.chip-toggle) {
    border-style: dashed;
    background: transparent;
  }
  .tag-chips :global(.chip-hidden) { display: none; }
  .tag-chips[data-collapse-wired="1"] :global(.chip[style*="--reveal-i"]:not(.chip-hidden)) {
    animation: chip-reveal 520ms cubic-bezier(0.22, 1, 0.36, 1)
      calc(var(--reveal-i, 0) * 35ms) both;
  }
  @keyframes chip-reveal {
    from { opacity: 0; transform: scale(0.92) translateY(-2px); }
    to { opacity: 1; transform: none; }
  }
  .sort-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-card);
    color: var(--color-fg);
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease;
  }
  .sort-toggle:hover,
  .sort-toggle:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .sort-arrow { font-weight: 700; line-height: 1; }
  .empty-msg { margin-top: 1rem; }
  @media (prefers-reduced-motion: reduce) {
    .tag-chips[data-collapse-wired="1"] :global(.chip[style*="--reveal-i"]:not(.chip-hidden)) {
      animation: none;
    }
  }
</style>
