---
import Base from '@/layouts/Base.astro';
import { tUi, type Lang } from '@/i18n/ui';
import { getCv } from '@/lib/content';
import { allCitations } from '@/lib/citations';
import { allBibtex } from '@/lib/bibtex';
import { render } from 'astro:content';
import Toc from '@/components/Toc.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;

const cv = await getCv(lang);
if (!cv) {
  throw new Error(`CV (${lang}) is missing. Add src/content/cv/${lang}.md`);
}
const { Content, headings } = await render(cv);
const tocMinDepth = headings.length > 0 ? Math.min(...headings.map((heading) => heading.depth)) : 2;
const tocHeadingCount = headings.filter(
  (heading) => heading.depth >= tocMinDepth && heading.depth <= tocMinDepth + 2,
).length;
const hasToc = tocHeadingCount >= 2;
const cvLinks = [
  cv.data.orcid
    ? { label: 'ORCID', url: `https://orcid.org/${cv.data.orcid}` }
    : undefined,
  cv.data.github ? { label: 'GitHub', url: cv.data.github } : undefined,
  cv.data.kaggle ? { label: 'Kaggle', url: cv.data.kaggle } : undefined,
  cv.data.huggingface
    ? { label: 'Hugging Face', url: cv.data.huggingface }
    : undefined,
].filter((link): link is { label: string; url: string } => Boolean(link));
---
<Base lang={lang} title={tUi('nav.cv')} image={lang === 'en' ? '/en/og/cv.png' : '/og/cv.png'}>
  <div class:list={['cv-layout', { 'has-toc': hasToc }]}>
    <Toc headings={headings} lang={lang} />
    <div class="cv-content">
      <div class="cv-header">
        <h1>{tUi('nav.cv')}</h1>
        {/* Page-level toolbar. Copy-all and .bib actions are collapsed into
            one disclosure menu built client-side by the script below — the
            same affordance as the per-section copy menus. */}
        <div
          class="cv-header-actions"
          data-cv-actions
          data-label-all={tUi('cv.copy.all')}
          data-label-bib={tUi('cv.copy.bib')}
          data-menu-aria={tUi('cv.actions.menu.aria')}
        ></div>
      </div>
      {cvLinks.length > 0 && (
        <nav aria-label="Profile links">
          <ul class="cv-profile-links">
            {cvLinks.map((link) => (
              <li>
                <a class="btn btn-ghost btn-sm" href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <div
        class="prose cv-prose"
        data-cv-lang={lang}
        data-copy-label={tUi('code.copy')}
        data-citations={JSON.stringify(allCitations)}
        data-citation-label={tUi('citation.label')}
        data-citation-source={tUi('citation.source')}
        data-bibtex={JSON.stringify(allBibtex)}
        data-bibtex-label={tUi('cv.copy.bibtex')}
        data-bibtex-aria={tUi('cv.copy.bibtex.aria')}
        data-section-bibtex-label={tUi('cv.copy.bibtex.section')}
        data-section-copy-label={tUi('cv.copy.section')}
        data-section-menu-label={tUi('cv.copy.section.menu')}
        data-section-menu-aria={tUi('cv.copy.section.menu.aria')}
        data-item-text-label={tUi('cv.copy.item.text')}
      ><Content /></div>
    </div>
  </div>
</Base>

<script>
  import { onReady } from '@/lib/dom-ready';
  import type { CitationEntry } from '@/lib/citations';
  import type { BibtexEntry } from '@/lib/bibtex';

  // Feather-style inline SVGs for the copy affordances (same glyphs as the
  // code-block copy button in Base.astro): a "copy" sheet pair, swapped for a
  // check on success. aria-hidden so the accessible name comes from each
  // button's aria-label, not the glyph.
  const COPY_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
  const CHECK_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';

  // Which entries are publications (peer-reviewed papers and preprints) and
  // which are presentations is declared in the CV markdown itself, via
  // `<!-- cv:section <kind> -->` markers that src/plugins/remark-cv-sections.mjs
  // turns into `data-cv-section` on each list at build time. Heading text is
  // therefore free-form — renaming or translating a heading can't silently
  // drop the BibTeX button or flip the clipboard font, which is exactly what
  // the previous heading-regex approach did.
  const sectionKind = (list: Element | null | undefined): string =>
    list?.getAttribute('data-cv-section') ?? '';

  // Only publications have a canonical BibTeX form — presentations,
  // education, awards etc. don't get the button.
  const isPublicationKind = (kind: string): boolean =>
    kind === 'peer-reviewed' || kind === 'preprints';

  function fontFamilyFor(lang: 'ja' | 'en', isPresentation: boolean): string {
    if (lang !== 'ja') return `'Times New Roman', serif`;
    // Word picks the first family that has a glyph for each codepoint.
    // For presentation entries (heavily Japanese), MS Mincho leads.
    // For other ja entries (heavily English paper titles), Times New
    // Roman leads but MS Mincho still covers any kana/kanji that appear.
    return isPresentation
      ? `'MS Mincho', '游明朝', 'Times New Roman', serif`
      : `'Times New Roman', 'MS Mincho', '游明朝', serif`;
  }

  // Replace each <a> with its own children, then drop the <a> shell.
  // Children may themselves carry formatting (<strong>, <u>, <em>) which
  // must be preserved — that's why we don't just collapse to textContent.
  function unwrapAnchors(root: HTMLElement): void {
    root.querySelectorAll('a').forEach((a) => {
      const parent = a.parentNode;
      if (!parent) return;
      while (a.firstChild) parent.insertBefore(a.firstChild, a);
      parent.removeChild(a);
    });
  }

  // Defense-in-depth before serialising to the clipboard's `text/html`
  // payload: even though the CV body is produced by our trusted Markdown
  // pipeline, a future plugin (or a fork of this site) could put active
  // markup in the DOM. Strip executable elements + event handlers + any
  // `javascript:` URL so paste into a downstream editor can't run code.
  function stripUnsafeForClipboard(root: HTMLElement): void {
    root.querySelectorAll('script, iframe, object, embed, form, style, link, meta, base').forEach((el) => el.remove());
    root.querySelectorAll('*').forEach((el) => {
      for (const attr of Array.from(el.attributes)) {
        if (/^on/i.test(attr.name)) el.removeAttribute(attr.name);
        else if (/^(href|src|xlink:href|action|formaction)$/i.test(attr.name) && /^\s*javascript:/i.test(attr.value)) {
          el.removeAttribute(attr.name);
        }
      }
    });
  }

  function buildHtml(li: Element, fontFamily: string): string {
    const clone = li.cloneNode(true) as HTMLElement;
    clone.querySelectorAll('.cv-copy-actions, .cv-section-actions, .citation-badge, .heading-anchor').forEach((b) => b.remove());
    unwrapAnchors(clone);
    stripUnsafeForClipboard(clone);
    // Force light foreground/background so Word/text editors don't inherit
    // the page's dark-mode colors (which would paste as black-on-black).
    // font-size in pt (not px/rem) so Word honours it as 10.5pt — the
    // Japanese default body size — instead of converting through DPI.
    return `<div style="font-family:${fontFamily};font-size:10.5pt;color:#000;background-color:#ffffff;line-height:1.6;">${clone.innerHTML}</div>`;
  }

  function buildPlainText(li: Element): string {
    const clone = li.cloneNode(true) as HTMLElement;
    clone.querySelectorAll('.cv-copy-actions, .cv-section-actions, .citation-badge, .heading-anchor').forEach((b) => b.remove());
    return (clone.textContent ?? '').replace(/\s+/g, ' ').trim();
  }

  // Extracts a normalized DOI (lowercased, trailing punctuation stripped)
  // from the first doi.org anchor inside an <li>. Matches the same
  // normalization rule used by sync-bibtex.mjs / sync-citation-counts.mjs
  // so the lookup key is consistent across build and runtime.
  function extractDoi(li: Element): string | null {
    const a = li.querySelector<HTMLAnchorElement>('a[href*="doi.org/"]');
    if (!a) return null;
    const m = a.href.match(/doi\.org\/(10\.[0-9]{4,9}\/[^\s)>"']+)/i);
    if (!m) return null;
    return decodeURIComponent(m[1]).toLowerCase().replace(/[.,;]+$/, '');
  }

  async function writeClipboard(html: string, text: string): Promise<boolean> {
    try {
      if ('ClipboardItem' in window && navigator.clipboard?.write) {
        const item = new ClipboardItem({
          'text/html': new Blob([html], { type: 'text/html' }),
          'text/plain': new Blob([text], { type: 'text/plain' }),
        });
        await navigator.clipboard.write([item]);
        return true;
      }
      await navigator.clipboard.writeText(text);
      return true;
    } catch (err) {
      console.warn('CV copy failed', err);
      return false;
    }
  }

  async function copyItem(li: Element, fontFamily: string): Promise<boolean> {
    return writeClipboard(buildHtml(li, fontFamily), buildPlainText(li));
  }

  // BibTeX is plain-text only — no HTML payload, so consumers like Zotero
  // / BibDesk / a .bib file editor get an unambiguous text/plain entry
  // instead of inheriting a styled text/html alternative.
  async function copyBibtex(bibtex: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(bibtex);
      return true;
    } catch (err) {
      console.warn('BibTeX copy failed', err);
      return false;
    }
  }

  // Walk .prose top-level children, partition on heading boundaries, and
  // wrap each partition with the appropriate font-family. This is the
  // only way to mix MS Mincho (presentation sections) and Times New
  // Roman (everything else) in a single clipboard payload while keeping
  // a single document.
  function buildFullHtml(prose: HTMLElement, lang: 'ja' | 'en'): string {
    const clone = prose.cloneNode(true) as HTMLElement;
    clone.querySelectorAll('.cv-copy-actions, .cv-section-actions, .citation-badge, .heading-anchor').forEach((b) => b.remove());
    unwrapAnchors(clone);
    stripUnsafeForClipboard(clone);

    if (lang !== 'ja') {
      const ff = fontFamilyFor('en', false);
      return wrapForClipboard(clone.innerHTML, ff);
    }

    const blocks: string[] = [];
    let currentKind = '';
    let buffer = '';
    const flush = () => {
      if (!buffer) return;
      const isPres = currentKind === 'presentations';
      blocks.push(wrapForClipboard(buffer, fontFamilyFor('ja', isPres)));
      buffer = '';
    };
    Array.from(clone.children).forEach((el) => {
      if (isHeading(el)) {
        flush();
        // The kind lives on the section's list, so look ahead from the
        // heading rather than reading the heading's own text. Any heading
        // level starts a new block — the CV is free to use `#` or `###`.
        currentKind = sectionKind(getSectionList(el));
      }
      buffer += el.outerHTML;
    });
    flush();
    return blocks.join('');
  }

  function wrapForClipboard(innerHtml: string, fontFamily: string): string {
    return `<div style="font-family:${fontFamily};font-size:10.5pt;color:#000;background-color:#ffffff;line-height:1.6;">${innerHtml}</div>`;
  }

  const normWs = (s: string | null) => (s ?? '').replace(/\s+/g, ' ').trim();

  // Walk a <ol>/<ul>, emitting one markdown-ish line per <li>. Handles
  // nested lists by recursion + indentation, so annotations like the
  // "*共同筆頭著者" sub-bullet under a paper survive into the plaintext.
  // Shared by buildFullPlainText (whole CV) and buildSectionPlainText
  // (a single H2's list).
  function renderListLines(list: Element, depth: number, lines: string[]): void {
    const ordered = list.tagName === 'OL';
    let idx = 0;
    Array.from(list.children).forEach((li) => {
      if (li.tagName !== 'LI') return;
      idx += 1;
      const indent = '  '.repeat(depth);
      const bullet = ordered ? `${idx}. ` : '- ';
      // Pull this <li>'s own text without descending into nested lists.
      const own = Array.from(li.childNodes)
        .filter((n) => !(n instanceof Element && (n.tagName === 'OL' || n.tagName === 'UL')))
        .map((n) => (n instanceof Element ? n.textContent : n.textContent))
        .join('');
      lines.push(indent + bullet + normWs(own));
      li.querySelectorAll(':scope > ol, :scope > ul').forEach((nested) => {
        renderListLines(nested, depth + 1, lines);
      });
    });
  }

  // Plain-text rendition of the whole CV. Keeps a markdown-ish shape so
  // pasting into a .txt file remains readable.
  function buildFullPlainText(prose: HTMLElement): string {
    const clone = prose.cloneNode(true) as HTMLElement;
    clone.querySelectorAll('.cv-copy-actions, .cv-section-actions, .citation-badge, .heading-anchor').forEach((b) => b.remove());
    const lines: string[] = [];
    Array.from(clone.children).forEach((el) => {
      const tag = el.tagName;
      if (isHeading(el)) {
        lines.push('', normWs(el.textContent), '');
      } else if (tag === 'OL' || tag === 'UL') {
        renderListLines(el, 0, lines);
        lines.push('');
      } else if (tag === 'P') {
        lines.push(normWs(el.textContent), '');
      }
    });
    return lines.join('\n').replace(/\n{3,}/g, '\n\n').trim();
  }

  async function copyAll(prose: HTMLElement, lang: 'ja' | 'en'): Promise<boolean> {
    return writeClipboard(buildFullHtml(prose, lang), buildFullPlainText(prose));
  }

  const isHeading = (el: Element): boolean => /^H[1-6]$/.test(el.tagName);
  const headingLevel = (el: Element): number => Number(el.tagName.slice(1));

  // Find the first <ol> / <ul> belonging to a heading: scan forward until a
  // heading of the SAME OR HIGHER rank ends the section. Levels are compared
  // relatively, never against a hard-coded <h2>, so the CV may promote or
  // demote its headings (`## 論文` → `# 論文` → `### 論文`) without losing the
  // section buttons. Sub-headings (### ポスター発表 under ## 学会発表) don't
  // terminate the scan, which is why the relative comparison matters.
  // Returns null when the section has no list — nothing to bulk-copy then.
  function getSectionList(heading: Element): Element | null {
    const level = headingLevel(heading);
    let cur = heading.nextElementSibling;
    while (cur) {
      if (isHeading(cur)) {
        if (headingLevel(cur) <= level) return null;
      } else if (cur.tagName === 'OL' || cur.tagName === 'UL') {
        return cur;
      }
      cur = cur.nextElementSibling;
    }
    return null;
  }

  // Section title with the runtime-appended action chips and the rehype
  // anchor # stripped out, so it's safe to embed as a heading line in
  // copied output without leaking UI affordances.
  function getSectionTitle(heading: Element): string {
    const clone = heading.cloneNode(true) as HTMLElement;
    clone.querySelectorAll('.cv-section-actions, .heading-anchor').forEach((b) => b.remove());
    return normWs(clone.textContent);
  }

  // Concatenate every paper's BibTeX into a single .bib-file payload,
  // prefixed with a `# Section Name` comment line so users pasting into a
  // `.bib` file get a human-readable section marker. BibTeX/Biber ignore
  // any text outside `@type{...}` entries, so the `#` line is harmless.
  // Skips entries whose DOI isn't in the snapshot. Returns null if nothing
  // was collected.
  function collectSectionBibtex(heading: Element, list: Element, entries: Record<string, BibtexEntry>): string | null {
    const out: string[] = [];
    list.querySelectorAll<HTMLElement>(':scope > li').forEach((li) => {
      const doi = extractDoi(li);
      const bib = doi ? entries[doi]?.bibtex : null;
      if (bib) out.push(bib);
    });
    if (out.length === 0) return null;
    const title = getSectionTitle(heading);
    return `# ${title}\n\n${out.join('\n\n')}`;
  }

  // Heading cloned from the actual element rather than recreated, so any
  // inline formatting (sub/sup, em, etc.) survives into the Word paste.
  // The .cv-section-actions chip group and the heading-anchor `#` are
  // stripped so they don't leak into the copied document.
  function cloneHeadingForClipboard(heading: Element): HTMLElement {
    const clone = heading.cloneNode(true) as HTMLElement;
    clone.querySelectorAll('.cv-section-actions, .heading-anchor').forEach((b) => b.remove());
    unwrapAnchors(clone);
    return clone;
  }

  function buildSectionHtml(heading: Element, list: Element, fontFamily: string): string {
    const headingClone = cloneHeadingForClipboard(heading);
    const listClone = list.cloneNode(true) as HTMLElement;
    listClone.querySelectorAll('.cv-copy-actions, .cv-section-actions, .citation-badge').forEach((b) => b.remove());
    unwrapAnchors(listClone);
    stripUnsafeForClipboard(headingClone);
    stripUnsafeForClipboard(listClone);
    return wrapForClipboard(headingClone.outerHTML + listClone.outerHTML, fontFamily);
  }

  function buildSectionPlainText(heading: Element, list: Element): string {
    const clone = list.cloneNode(true) as HTMLElement;
    clone.querySelectorAll('.cv-copy-actions, .cv-section-actions, .citation-badge, .heading-anchor').forEach((b) => b.remove());
    const lines: string[] = [getSectionTitle(heading), ''];
    renderListLines(clone, 0, lines);
    return lines.join('\n');
  }

  async function copySection(heading: Element, list: Element, fontFamily: string): Promise<boolean> {
    return writeClipboard(buildSectionHtml(heading, list, fontFamily), buildSectionPlainText(heading, list));
  }

  onReady(() => {
    const prose = document.querySelector<HTMLElement>('.cv-prose[data-cv-lang]');
    if (!prose) return;

    const lang: 'ja' | 'en' = prose.dataset.cvLang === 'en' ? 'en' : 'ja';
    const copyLabel = prose.dataset.copyLabel ?? 'Copy';
    const bibtexLabel = prose.dataset.bibtexLabel ?? 'BibTeX';
    const itemTextLabel = prose.dataset.itemTextLabel ?? 'Text';
    const sectionBibtexLabel = prose.dataset.sectionBibtexLabel ?? 'All as BibTeX';
    const sectionCopyLabel = prose.dataset.sectionCopyLabel ?? 'Copy list';
    const sectionMenuAria = prose.dataset.sectionMenuAria ?? 'Copy options';

    // CrossRef cited-by badges. Render only when count > 0 — a "cited by 0"
    // chip on a brand-new paper is noise.
    let citations: Record<string, CitationEntry> = {};
    try { citations = JSON.parse(prose.dataset.citations ?? '{}'); } catch {}
    const citationLabel = prose.dataset.citationLabel ?? 'cited by {n}';
    const citationSource = prose.dataset.citationSource ?? 'via CrossRef';
    const doiPattern = /^https?:\/\/(?:dx\.)?doi\.org\/(.+)$/i;
    prose.querySelectorAll<HTMLAnchorElement>('a[href*="doi.org/"]').forEach((a) => {
      const m = a.href.match(doiPattern);
      if (!m) return;
      const doi = decodeURIComponent(m[1]).toLowerCase().replace(/[.,;]+$/, '');
      const entry = citations[doi];
      if (!entry || typeof entry.count !== 'number' || entry.count <= 0) return;
      const badge = document.createElement('span');
      badge.className = 'citation-badge badge badge-outline badge-sm';
      badge.textContent = citationLabel.replace('{n}', String(entry.count));
      badge.title = `${citationSource} · ${entry.fetchedAt.slice(0, 10)}`;
      a.insertAdjacentElement('afterend', badge);
    });

    let bibtexEntries: Record<string, BibtexEntry> = {};
    try { bibtexEntries = JSON.parse(prose.dataset.bibtex ?? '{}'); } catch {}

    // Build a disclosure <details> that collapses several actions behind one
    // trigger. Shared by per-entry (<li>), per-section (<h2>) copy affordances
    // and the page-level header toolbar. The trigger shows `triggerIcon`
    // (defaults to the copy glyph); `triggerSizingClass` (.cv-copy-btn /
    // .cv-section-btn / .cv-header-btn) sets the chip size and selects which
    // hover rule reveals it. A `run` item copies and flashes feedback on the
    // trigger then closes the menu.
    const buildCopyMenu = (
      triggerAria: string,
      triggerSizingClass: string,
      menuItems: { label: string; run: () => Promise<boolean> }[],
      triggerIcon: string = COPY_ICON,
    ): HTMLDetailsElement => {
      const details = document.createElement('details');
      details.className = 'cv-menu';

      const summary = document.createElement('summary');
      summary.className = `${triggerSizingClass} cv-menu-trigger btn btn-ghost btn-sm`;
      summary.innerHTML = triggerIcon;
      summary.setAttribute('aria-label', triggerAria);
      details.appendChild(summary);

      const list = document.createElement('div');
      list.className = 'cv-menu-list';

      const flash = (ok: boolean) => {
        summary.innerHTML = ok ? CHECK_ICON : triggerIcon;
        details.classList.toggle('is-copied', ok);
        details.classList.toggle('is-failed', !ok);
        details.open = false;
        window.setTimeout(() => {
          summary.innerHTML = triggerIcon;
          details.classList.remove('is-copied', 'is-failed');
        }, 1800);
      };

      for (const mi of menuItems) {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'cv-menu-item btn btn-ghost btn-sm';
        item.textContent = mi.label;
        item.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (mi.run) flash(await mi.run());
        });
        list.appendChild(item);
      }

      details.appendChild(list);
      return details;
    };

    // Top-level list items only — nested annotations like "*共同筆頭著者"
    // get carried inside their parent <li> via cloneNode, so they don't
    // need their own button.
    const items = prose.querySelectorAll<HTMLElement>(
      ':scope > ol > li, :scope > ul > li',
    );

    items.forEach((li) => {
      // These are top-level <li>s, so the parent is the marked list itself.
      const kind = sectionKind(li.parentElement);
      const isPres = lang === 'ja' && kind === 'presentations';
      const isPub = isPublicationKind(kind);
      const ff = fontFamilyFor(lang, isPres);

      const actions = document.createElement('div');
      actions.className = 'cv-copy-actions';

      // Publication entries with a known BibTeX snapshot carry two distinct
      // copies (formatted text + BibTeX) — collapse them into one menu, the
      // same affordance as the section headings. Everything else keeps a
      // single Copy button (a one-item menu would be silly).
      const doi = isPub ? extractDoi(li) : null;
      const bibtex = doi ? bibtexEntries[doi]?.bibtex : null;

      if (bibtex) {
        actions.appendChild(
          buildCopyMenu(copyLabel, 'cv-copy-btn', [
            { label: itemTextLabel, run: () => copyItem(li, ff) },
            { label: bibtexLabel, run: () => copyBibtex(bibtex) },
          ]),
        );
      } else {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'cv-copy-btn btn btn-ghost btn-sm';
        btn.innerHTML = COPY_ICON;
        btn.setAttribute('aria-label', copyLabel);
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          const ok = await copyItem(li, ff);
          btn.innerHTML = ok ? CHECK_ICON : COPY_ICON;
          btn.classList.toggle('is-copied', ok);
          btn.classList.toggle('is-failed', !ok);
          window.setTimeout(() => {
            btn.innerHTML = COPY_ICON;
            btn.classList.remove('is-copied', 'is-failed');
          }, 1600);
        });
        actions.appendChild(btn);
      }

      li.classList.add('cv-copyable');
      if (bibtex) li.classList.add('cv-has-bibtex');
      li.appendChild(actions);
    });

    // Section-level bulk-copy buttons on every heading that owns a list. The
    // Copy-list button is universal (works off the DOM only); the BibTeX
    // button is gated on (a) a publication-marked list + (b) at least one
    // entry in the snapshot.
    //
    // Any heading level qualifies, so the CV can use `#`/`##`/`###` however
    // it likes. Headings are visited in document order and each list is
    // claimed once, so when a section heading and a sub-heading both resolve
    // to the same list the outer one keeps the button — no duplicate chips.
    const claimedLists = new Set<Element>();
    const headings = prose.querySelectorAll<HTMLHeadingElement>(
      'h1, h2, h3, h4, h5, h6',
    );
    headings.forEach((heading) => {
      const list = getSectionList(heading);
      if (!list || claimedLists.has(list)) return;
      claimedLists.add(list);
      const kind = sectionKind(list);
      const isPub = isPublicationKind(kind);
      const isPres = lang === 'ja' && kind === 'presentations';
      const ff = fontFamilyFor(lang, isPres);

      const actions = document.createElement('span');
      actions.className = 'cv-section-actions';

      // Publication sections may carry two distinct copies — the formatted
      // list and the section's BibTeX bundle. `collectSectionBibtex` is null
      // when no entry in the section is in the snapshot (then there's only
      // one action, even for a publication heading).
      const bulkBibtex = isPub ? collectSectionBibtex(heading, list, bibtexEntries) : null;

      if (bulkBibtex) {
        // Two actions → one disclosure menu so the heading carries a single
        // chip instead of two side-by-side buttons.
        actions.appendChild(
          buildCopyMenu(sectionMenuAria, 'cv-section-btn', [
            { label: sectionCopyLabel, run: () => copySection(heading, list, ff) },
            { label: sectionBibtexLabel, run: () => copyBibtex(bulkBibtex) },
          ]),
        );
      } else {
        // Single action → a plain icon button (a one-item menu would be
        // silly). Same copy→check glyph swap as the per-item button; the
        // label survives as the aria-label so the icon stays accessible.
        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'cv-section-btn cv-section-copy btn btn-ghost btn-sm';
        copyBtn.innerHTML = COPY_ICON;
        copyBtn.setAttribute('aria-label', sectionCopyLabel);
        copyBtn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          const ok = await copySection(heading, list, ff);
          copyBtn.innerHTML = ok ? CHECK_ICON : COPY_ICON;
          copyBtn.classList.toggle('is-copied', ok);
          copyBtn.classList.toggle('is-failed', !ok);
          window.setTimeout(() => {
            copyBtn.innerHTML = COPY_ICON;
            copyBtn.classList.remove('is-copied', 'is-failed');
          }, 1800);
        });
        actions.appendChild(copyBtn);
      }

      heading.classList.add('cv-section-heading');
      heading.appendChild(actions);
    });

    // Native <details> stays open until its own summary is clicked again —
    // wire Escape and outside-click so the copy menus behave like a normal
    // popover. Clicking inside a menu keeps it open; opening one closes any
    // other (only one menu open at a time). Scoped to the whole document, not
    // just `.cv-prose`, so the header toolbar menu (which lives outside the
    // prose container) is dismissed by the same rules.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll<HTMLDetailsElement>('.cv-menu[open]').forEach((d) => {
        d.open = false;
      });
    });
    document.addEventListener('click', (e) => {
      const current = e.target instanceof Element ? e.target.closest('.cv-menu') : null;
      document.querySelectorAll<HTMLDetailsElement>('.cv-menu[open]').forEach((d) => {
        if (d !== current) d.open = false;
      });
    });

    // Page-level toolbar (copy all / copy .bib) collapsed into one disclosure
    // menu — the same affordance as the per-section copy menus. `fullBib`
    // joins every BibTeX entry the same way
    // `src/pages/cv.bib.ts` does (DOI-sorted in the source JSON), so a paste
    // matches a `/cv.bib` download.
    const headerActions = document.querySelector<HTMLElement>('[data-cv-actions]');
    if (headerActions) {
      const allLabel = headerActions.dataset.labelAll ?? 'Copy all';
      const bibLabel = headerActions.dataset.labelBib ?? 'Copy .bib';
      const menuAria = headerActions.dataset.menuAria ?? 'CV actions';
      const fullBib = Object.values(bibtexEntries)
        .map((e) => e.bibtex)
        .filter(Boolean)
        .join('\n\n') + '\n';
      headerActions.appendChild(
        buildCopyMenu(menuAria, 'cv-header-btn', [
          { label: allLabel, run: () => copyAll(prose, lang) },
          { label: bibLabel, run: () => copyBibtex(fullBib) },
        ]),
      );
    }
  });
</script>

