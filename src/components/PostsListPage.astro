---
import Base from '@/layouts/Base.astro';
import PostArchiveList from './PostArchiveList.astro';
import LocaleContent from './LocaleContent.astro';
import { tUi, type Lang } from '@/i18n/ui';
import { getPosts, sortByDateDesc } from '@/lib/content';
import { getLocaleFileUrl } from '@/lib/locale-url';

interface Props { lang: Lang }
const { lang } = Astro.props;

const posts = sortByDateDesc(await getPosts(), 'pubDate');
---
<Base lang={lang} title={tUi('nav.posts')} image={getLocaleFileUrl(lang, '/og/posts.png')}>
  <h1 class="sr-only">{tUi('nav.posts')}</h1>
  <LocaleContent>
    <PostArchiveList slot="en" posts={posts.filter((post) => post.data.lang.includes('en'))} lang="en" largeTitles />
    <PostArchiveList slot="ja" posts={posts.filter((post) => post.data.lang.includes('ja'))} lang="ja" largeTitles />
  </LocaleContent>
</Base>
