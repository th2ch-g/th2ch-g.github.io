---
import { getRelativeLocaleUrl } from '@/lib/locale-url';
import { languages, tUi, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  // Locales this page actually exists in. Defaults to all (most pages are
  // fully mirrored). Pages whose translation is absent (e.g. a ja-only post)
  // pass a subset so we never render a switch link to a URL that 404s. The
  // current `lang` is always expected to be present in the list.
  availableLocales?: Lang[];
}
const { lang, availableLocales } = Astro.props;
const visible = availableLocales ?? (Object.keys(languages) as Lang[]);

const currentPath = Astro.url.pathname.replace(/^\/(en|ja)(?=\/|$)/, '') || '/';
---
{visible.length > 1 && <div class="lang-switch join" aria-label={tUi('lang.switch')}>
  {(Object.keys(languages) as Lang[])
    .filter((code) => visible.includes(code))
    .map((code) => (
    <a
      href={getRelativeLocaleUrl(code, currentPath)}
      class:list={['pill', { active: code === lang }]}
      aria-current={code === lang ? 'true' : undefined}
      hreflang={code}
      lang="en"
    >{languages[code]}</a>
  ))}
</div>}

<style>
  .lang-switch {
    display: inline-flex;
    flex-shrink: 0;
    gap: 0;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-field);
    background: var(--color-button);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    min-width: 2.25rem;
    padding: 0.25rem 0.5rem;
    line-height: 1;
    border: 0;
    border-radius: calc(var(--radius-field) - 1px);
    color: var(--color-muted);
  }
  .pill.active {
    color: var(--color-fg);
    background: var(--color-bg);
    box-shadow: 0 0 0 1px var(--color-border-strong), var(--shadow-soft);
    font-weight: 600;
  }
  .pill:hover { background: var(--color-hover); text-decoration: none; }
</style>
