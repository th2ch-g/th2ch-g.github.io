---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, tUi, type Lang } from '@/i18n/ui';
import { getProfileMeta } from '@/lib/content';
import { SiteHeader } from './SiteHeader';

interface Props {
  lang: Lang;
  availableLocales?: Lang[];
}

const { lang, availableLocales } = Astro.props;
const meta = await getProfileMeta(lang);
const visibleLocales = availableLocales ?? (Object.keys(languages) as Lang[]);
const currentWithSlash = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const homeHref = getRelativeLocaleUrl(lang, '/');
const currentPath = Astro.url.pathname.replace(/^\/(en|ja)(?=\/|$)/, '') || '/';

const navItems = [
  { href: getRelativeLocaleUrl(lang, '/posts'), label: tUi('nav.posts') },
  { href: getRelativeLocaleUrl(lang, '/cv'), label: tUi('nav.cv') },
  { href: getRelativeLocaleUrl(lang, '/gallery'), label: tUi('nav.photos') },
  { href: getRelativeLocaleUrl(lang, '/contact'), label: tUi('nav.contact') },
].map((item) => {
  const target = item.href.endsWith('/') ? item.href : `${item.href}/`;
  return { ...item, active: currentWithSlash === target || currentWithSlash.startsWith(target) };
});

const localeItems = (Object.keys(languages) as Lang[])
  .filter((code) => visibleLocales.includes(code))
  .map((code) => ({
    code,
    label: languages[code],
    href: `${getRelativeLocaleUrl(code, currentPath)}${Astro.url.search}`,
    active: code === lang,
  }));
---
<SiteHeader
  client:load
  homeHref={homeHref}
  homeLabel={tUi('nav.home')}
  homeActive={currentWithSlash === (homeHref.endsWith('/') ? homeHref : `${homeHref}/`)}
  icon={meta.icon}
  navItems={navItems}
  localeItems={localeItems}
  menuLabel={tUi('nav.menu')}
  searchLabel={tUi('search.title')}
  searchPlaceholder={tUi('search.placeholder')}
  themeLabel={tUi('theme.toggle')}
  languageLabel={tUi('lang.switch')}
/>
