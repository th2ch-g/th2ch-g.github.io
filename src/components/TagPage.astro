---
import Base from '@/layouts/Base.astro';
import PostArchiveList from './PostArchiveList.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { tUi, type Lang } from '@/i18n/ui';
import { getPublishedByLang, sortByDateDesc } from '@/lib/content';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  lang: Lang;
  tag: string;
}
const { lang, tag } = Astro.props;

// Match PostsListPage / ArchivePage / posts [...slug]: drafts are visible
// in dev (`npm run dev`) but excluded from production. Without the DEV
// guard a draft visible elsewhere would 404 from its own tag page.
const posts = sortByDateDesc(
  (await getPublishedByLang('posts', lang, { includeDevDrafts: true })).filter((p) =>
    (p.data.tags ?? []).includes(tag),
  ),
  'pubDate',
);
const tagFeed = lang === 'en' ? `/en/tags/${tag}.xml` : `/tags/${tag}.xml`;
// The per-tag OG card and RSS feed are generated from the PRODUCTION post
// set (drafts always excluded, per the no-draft-in-syndication invariant),
// so only advertise them when this tag has a non-draft post. A draft-only
// tag is visible in `npm run dev` but its card/feed route is never emitted,
// so linking them would 404 in preview.
const tagFeedExists = (await getPublishedByLang('posts', lang)).some((p) =>
  (p.data.tags ?? []).includes(tag),
);
// Does the opposite locale have any post under this tag? If not, suppress the
// language switch / hreflang to it — buildTagPaths won't emit a
// /<other>/tags/<tag> page, so the link would 404. Same draft filter as
// getStaticPaths for dev/prod parity.
const otherLang: Lang = lang === 'ja' ? 'en' : 'ja';
const otherHasTag = (
  await getPublishedByLang('posts', otherLang, { includeDevDrafts: true })
).some((p) => (p.data.tags ?? []).includes(tag));
const availableLocales: Lang[] = otherHasTag ? ['ja', 'en'] : [lang];
---
<Base
  lang={lang}
  availableLocales={availableLocales}
  title={`${tUi('tags.heading')}: #${tag}`}
  image={tagFeedExists
    ? (lang === 'en' ? `/en/og/tags/${tag}.png` : `/og/tags/${tag}.png`)
    : undefined}
>
  <Breadcrumbs
    lang={lang}
    items={[
      { label: tUi('nav.home'), href: getRelativeLocaleUrl(lang, '/') },
      { label: tUi('nav.posts'), href: getRelativeLocaleUrl(lang, '/posts') },
      { label: `#${tag}` },
    ]}
  />
  <div class="tag-head">
    <h1 class="count-heading">
      #{tag}
      {posts.length > 0 && (
        <span class="count-badge badge badge-primary badge-outline">{posts.length}</span>
      )}
    </h1>
    {tagFeedExists && (
      <a class="tag-feed btn btn-ghost btn-sm" href={tagFeed} aria-label={tUi('feed.tag.title')}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1" />
        </svg>
        <span>RSS</span>
      </a>
    )}
  </div>

  {posts.length > 0 ? (
    <PostArchiveList posts={posts} lang={lang} />
  ) : (
    <p class="muted">{tUi('list.empty')}</p>
  )}
</Base>

<style>
  .tag-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .tag-head h1 { margin: 0; }
  .tag-feed {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-muted);
    font-size: 0.8rem;
    text-decoration: none;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .tag-feed:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
